  .network-dot { transition: opacity var(--ds-motion-fast, 160ms) ease, transform var(--ds-motion-fast, 160ms) ease; transform-box: fill-box; transform-origin: center; }
  .network-dot.low { fill: var(--ds-data-context, #c1c7cd); opacity: .55; }
  .network-dot.medium { fill: var(--ds-data-secondary, #78a9ff); opacity: .82; }
  .network-dot.high { fill: var(--ds-data-focus, #0f62fe); opacity: .96; }
  .city-marker { cursor: pointer; outline: none; }
  .city-marker > circle:first-child { fill: var(--ds-surface, #fff); stroke: var(--ds-surface, #fff); stroke-width: 3; transition: transform var(--ds-motion-base, 220ms) var(--ds-ease, ease); transform-box: fill-box; transform-origin: center; }
  .city-marker .marker-core { fill: var(--ds-blue-300, #78a9ff); transition: fill var(--ds-motion-fast, 160ms) ease, transform var(--ds-motion-base, 220ms) var(--ds-ease, ease); transform-box: fill-box; transform-origin: center; }
  .city-marker.high .marker-core { fill: var(--ds-blue-600, #0f62fe); }
