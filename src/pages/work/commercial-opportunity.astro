---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import OpportunityMap from '../../components/OpportunityMap.astro';
---

<CaseStudyLayout
  title="Commercial Opportunity Prioritisation"
  eyebrow="01 / 03 · Commercial Strategy"
  client="Global beverage company"
  question="Which commercial opportunities should be prioritised?"
  summary="The work brought market, commercial and contextual information into a more structured basis for prioritising opportunities across a large network."
>
  <div slot="visual">
    <OpportunityMap />
  </div>

  <section class="case-block">
    <h3>Context</h3>
    <p>A large commercial network creates a prioritisation challenge: not every location represents the same strategic or commercial opportunity.</p>
  </section>

  <section class="case-block">
    <h3>My contribution</h3>
    <ul>
      <li>Supported the analytical and prioritisation approach.</li>
      <li>Analysed commercial and market information.</li>
      <li>Translated findings into decision-support outputs.</li>
    </ul>
  </section>

  <section class="case-block">
    <h3>Evidence</h3>
    <p><strong>12k+</strong> locations analysed across multiple Italian markets. Visuals use synthetic data for confidentiality.</p>
  </section>
</CaseStudyLayout>
