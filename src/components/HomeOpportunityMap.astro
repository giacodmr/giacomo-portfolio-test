  .map-callout em { color: var(--ds-blue-700, #0043ce); font: 600 .61rem/1.2 var(--ds-font-sans, 'IBM Plex Sans', sans-serif); font-style: normal; }
  .map-caption { margin: 10px 0 0; color: var(--ds-subtle, #6e7781); font: 400 .52rem/1.3 var(--ds-font-sans, 'IBM Plex Sans', sans-serif); text-align: center; }
