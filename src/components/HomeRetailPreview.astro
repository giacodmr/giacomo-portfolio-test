  }
  .frequency-panel.is-active .dot { transform: scale(1.13); }
  .dot.neutral { fill: var(--ds-data-context, #c1c7cd); }
  .dot.accent { fill: var(--ds-data-secondary, #78a9ff); }
  .dot.focus { fill: var(--ds-data-focus, #0f62fe); }
  .dotplot-wrap text { fill: var(--ds-ink, #1f2328); font-family: var(--ds-font-sans, 'IBM Plex Sans', sans-serif); font-size: 9px; font-weight: 600; text-anchor: middle; }
  .dotplot-axis { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; margin-top: 0; }

  .report-note { grid-column: 1 / -1; margin: 0; padding: 11px 0; border-top: 1px solid var(--ds-border-light, #eaeef2); color: var(--ds-subtle, #6e7781); font-family: var(--ds-font-sans, 'IBM Plex Sans', sans-serif); font-size: .56rem; }

  @media (max-width: 760px) {
