  .hbar-row > i > b.focus { background: var(--ds-data-focus, #0f62fe); }

  .dotplot-wrap { padding-top: 13px; }
  .dotplot-wrap svg { display: block; width: 100%; height: 148px; overflow: visible; }
  .grid-lines line { stroke: var(--ds-border-light, #eaeef2); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .trend-line {
    fill: none;
    stroke: var(--ds-data-secondary, #78a9ff);
    stroke-width: 1.7;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 310;
    stroke-dashoffset: 310;
    transition: stroke-dashoffset 650ms var(--ds-ease, ease);
  }
  .retail-report.is-ready .trend-line { stroke-dashoffset: 0; }
  .dot {
    stroke: var(--ds-surface, #ffffff);
    stroke-width: 2;
