    margin-top: 34px;
  }

  .workflow-step {
    min-width: 0;
    min-height: 196px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    padding: 17px;
    border: 1px solid var(--ds-graphite-70, #525252);
    border-radius: 10px;
    background: var(--ds-graphite-90, #262626);
    outline: none;
    opacity: 0;
    transform: translateY(9px);
    transition:
      opacity 360ms var(--ds-ease, ease),
      transform 360ms var(--ds-ease, ease),
      border-color var(--ds-motion-base, 220ms) var(--ds-ease, ease),
      background var(--ds-motion-base, 220ms) var(--ds-ease, ease);
  }

  .workflow-step:nth-child(1) { transition-delay: 0ms; }
  .workflow-step:nth-child(3) { transition-delay: 120ms; }
  .workflow-step:nth-child(5) { transition-delay: 240ms; }
  .workflow-step:nth-child(7) { transition-delay: 360ms; }
  .workflow-step:nth-child(9) { transition-delay: 480ms; }

  .workflow-preview.is-ready .workflow-step {
    opacity: 1;
    transform: translateY(0);
  }

  .workflow-step span {
    color: var(--ds-data-low, #c1c7cd);
    font-size: .59rem;
    letter-spacing: .12em;
  }

  .workflow-step strong {
    color: var(--ds-white, #ffffff);
    font-size: .84rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .workflow-step small {
    color: #c6c6c6;
    font-size: .61rem;
    line-height: 1.45;
  }

  .workflow-step-accent {
    border-color: var(--ds-blue-300, #78a9ff);
    background: color-mix(in srgb, var(--ds-blue-800, #002d9c) 42%, var(--ds-graphite-90, #262626));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ds-blue-300, #78a9ff) 18%, transparent);
  }

  .workflow-preview.has-active .workflow-step:not(.is-active) { opacity: .54; }
  .workflow-preview .workflow-step.is-active {
    opacity: 1;
    transform: translateY(-3px);
    border-color: var(--ds-blue-300, #78a9ff);
    background: color-mix(in srgb, var(--ds-blue-800, #002d9c) 24%, var(--ds-graphite-90, #262626));
  }

  .workflow-step:focus-visible {
    box-shadow: 0 0 0 2px var(--ds-blue-300, #78a9ff);
  }

  .workflow-arrow {
    display: grid;
    place-items: center;
    color: var(--ds-blue-300, #78a9ff);
    font-size: .92rem;
    opacity: .58;
    transition: opacity var(--ds-motion-fast, 160ms) ease, transform var(--ds-motion-fast, 160ms) var(--ds-ease, ease);
  }

  .workflow-preview.has-active .workflow-arrow { opacity: .9; transform: translateX(2px); }

  @media (max-width: 860px) {
    .workflow-preview { grid-template-columns: 1fr; }
    .workflow-step { min-height: 126px; }
    .workflow-arrow { transform: rotate(90deg); min-height: 16px; }
    .workflow-preview.has-active .workflow-arrow { transform: rotate(90deg) translateX(2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .workflow-step,
    .workflow-arrow { transition: none; }
    .workflow-step { opacity: 1; transform: none; }
    .workflow-preview .workflow-step.is-active { transform: none; }
  }
</style>
