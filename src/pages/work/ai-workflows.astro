---
import '../../styles/design-tokens.css';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import AIWorkflow from '../../components/AIWorkflow.astro';
---

<CaseStudyLayout
  title="AI-enabled Consulting Workflows"
  eyebrow="03 / 03 · Applied AI"
  client="Internal transformation / Consulting organisation"
  question="How can recurring consulting workflows be redesigned using AI without losing business judgement?"
  summary="The approach positions AI as one layer in a controlled workflow: structured inputs, AI-supported analysis, consultant validation and decision-ready output."
>
  <div slot="visual" style="padding:22px;border:1px solid var(--ds-graphite-70);border-radius:12px;background:var(--ds-graphite-100);">
    <AIWorkflow />
  </div>

  <section class="case-block">
    <h3>Approach</h3>
    <p>Identify recurring tasks suitable for AI support, structure the input and review logic, then keep human validation explicit before business decisions.</p>
  </section>

  <section class="case-block">
    <h3>My contribution</h3>
    <ul>
      <li>Structured use cases and business requirements.</li>
      <li>Tested AI-supported analysis and synthesis approaches.</li>
      <li>Contributed to workflow redesign and practical adoption.</li>
    </ul>
  </section>

  <section class="case-block">
    <h3>Evidence</h3>
    <p>Selected as AI Champion — Consumer. No confidential client prompts, documents or proprietary workflows are shown.</p>
  </section>
</CaseStudyLayout>
