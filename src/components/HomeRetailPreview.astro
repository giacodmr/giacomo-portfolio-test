<div class="retail-report" data-retail-report role="group" aria-label="Synthetic retail performance report combining a store distribution histogram, horizontal average-ticket bars, and a purchase-frequency trend">
  <section class="viz-panel distribution-panel" tabindex="0" data-viz-panel>
    <header><span>01</span><strong>Store performance distribution</strong></header>
    <div class="histogram" aria-hidden="true">
      <i style="--h: 27%"></i><i style="--h: 46%"></i><i style="--h: 69%"></i><i style="--h: 88%"></i><i style="--h: 100%"></i><i style="--h: 82%"></i><i style="--h: 61%"></i><i class="focus" style="--h: 39%"></i><i class="focus-strong" style="--h: 22%"></i>
    </div>
    <div class="distribution-axis" aria-hidden="true"><span>Lower</span><span>Core</span><span>Top</span></div>
    <p><b>Top 20%</b> of stores separated from the network baseline.</p>
  </section>

  <section class="viz-panel ticket-panel" tabindex="0" data-viz-panel>
    <header><span>02</span><strong>Average ticket index</strong></header>
    <div class="horizontal-bars" aria-hidden="true">
      <div class="hbar-row"><span>Low</span><i><b style="--w: 68%"></b></i><strong>82</strong></div>
      <div class="hbar-row"><span>Core</span><i><b style="--w: 78%"></b></i><strong>94</strong></div>
      <div class="hbar-row"><span>High</span><i><b class="accent" style="--w: 89%"></b></i><strong>108</strong></div>
      <div class="hbar-row"><span>Top</span><i><b class="focus" style="--w: 100%"></b></i><strong>121</strong></div>
    </div>
    <p>Index increases consistently across performance clusters.</p>
  </section>

  <section class="viz-panel frequency-panel" tabindex="0" data-viz-panel>
    <header><span>03</span><strong>Purchase frequency index</strong></header>
    <div class="dotplot-wrap" aria-hidden="true">
      <svg viewBox="0 0 260 112" preserveAspectRatio="none">
        <g class="grid-lines"><line x1="16" x2="244" y1="88" y2="88" /><line x1="16" x2="244" y1="58" y2="58" /><line x1="16" x2="244" y1="28" y2="28" /></g>
        <polyline class="trend-line" points="28,82 92,63 156,46 224,24" />
        <circle class="dot neutral" cx="28" cy="82" r="5" /><circle class="dot neutral" cx="92" cy="63" r="5" /><circle class="dot accent" cx="156" cy="46" r="5.5" /><circle class="dot focus" cx="224" cy="24" r="6" />
        <text x="28" y="70">75</text><text x="92" y="51">91</text><text x="156" y="34">104</text><text x="224" y="12">118</text>
      </svg>
      <div class="dotplot-axis"><span>Low</span><span>Core</span><span>High</span><span>Top</span></div>
    </div>
    <p>Higher-performing clusters show stronger repeat-purchase behaviour.</p>
  </section>

  <p class="report-note">Illustrative reconstruction with synthetic values.</p>
</div>

<script>
  document.querySelectorAll('[data-retail-report]').forEach((report) => {
    const panels = report.querySelectorAll('[data-viz-panel]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setActive = (panel) => {
      report.classList.add('has-active');
      panels.forEach((item) => item.classList.toggle('is-active', item === panel));
    };

    const clearActive = () => {
      report.classList.remove('has-active');
      panels.forEach((item) => item.classList.remove('is-active'));
    };

    panels.forEach((panel) => {
      panel.addEventListener('mouseenter', () => setActive(panel));
      panel.addEventListener('mouseleave', clearActive);
      panel.addEventListener('focus', () => setActive(panel));
      panel.addEventListener('blur', clearActive);
    });

    if (reduceMotion) {
      report.classList.add('is-ready');
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          report.classList.add('is-ready');
          observer.disconnect();
        });
      }, { threshold: 0.25 });
      observer.observe(report);
    }
  });
</script>

<style>
