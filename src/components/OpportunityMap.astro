<script>
  document.querySelectorAll('[data-italy-map]').forEach((map) => {
    const markers = map.querySelectorAll('.interactive');
    const tooltip = map.querySelector('[data-map-tooltip]');
    const city = map.querySelector('[data-map-city]');
    const score = map.querySelector('[data-map-score]');
    const priority = map.querySelector('[data-map-priority]');

    const activate = (marker) => {
      markers.forEach((item) => item.classList.toggle('is-muted', item !== marker));
      marker.classList.add('is-active');
      if (city) city.textContent = marker.dataset.city || '';
      if (score) score.textContent = marker.dataset.score || '';
      if (priority) priority.textContent = marker.dataset.priority || '';
      if (tooltip) tooltip.classList.add('is-visible');
    };

    markers.forEach((marker) => {
      marker.addEventListener('mouseenter', () => activate(marker));
      marker.addEventListener('focus', () => activate(marker));
      marker.addEventListener('click', () => activate(marker));
    });
  });
</script>

<style>
  .italy-map { position: relative; width: 100%; }
  svg { display: block; width: 100%; height: auto; }
  .italy-shape path { fill: var(--ds-blue-100, #d0e2ff); stroke: color-mix(in srgb, var(--ds-blue-600, #0f62fe) 34%, var(--ds-border, #d0d7de)); stroke-width: 1.2; }
  .dot.low { fill: var(--ds-data-context, #c1c7cd); }
  .dot.medium { fill: var(--ds-data-secondary, #78a9ff); }
  .dot.high { fill: var(--ds-data-focus, #0f62fe); }
  .city { stroke: var(--ds-surface, #fff); stroke-width: 4; transition: opacity .18s ease, transform .18s ease; transform-box: fill-box; transform-origin: center; }
  .city.high { fill: var(--ds-blue-600, #0f62fe); }
  .city.medium { fill: var(--ds-blue-300, #78a9ff); }
  .city.is-muted { opacity: .55; }
  .city.is-active { transform: scale(1.12); }
  .city-labels text { fill: var(--ds-muted, #57606a); font: 500 12px/1 var(--ds-font-sans, 'IBM Plex Sans', sans-serif); }
  .map-tooltip { position: absolute; top: 7%; right: 3%; display: grid; gap: 7px; min-width: 170px; padding: 16px; border: 1px solid var(--ds-border, #d0d7de); border-radius: var(--ds-radius-sm, 8px); background: color-mix(in srgb, var(--ds-surface, #fff) 96%, transparent); box-shadow: 0 14px 35px rgba(31,35,40,.08); }
  .map-tooltip strong { color: var(--ds-ink, #1f2328); font-size: .95rem; }
  .map-tooltip span { color: var(--ds-muted, #57606a); font-size: .7rem; }
  .map-tooltip em { color: var(--ds-blue-700, #0043ce); font-size: .7rem; font-style: normal; font-weight: 600; }
  @media (max-width: 640px) { .map-tooltip { position: static; margin-top: 12px; } .city-labels text { font-size: 10px; } }
</style>
