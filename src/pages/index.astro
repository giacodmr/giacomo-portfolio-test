---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import HeroIntro from '../components/HeroIntro.astro';
import OpportunityMap from '../components/OpportunityMap.astro';
import RetailScatter from '../components/RetailScatter.astro';
import AIWorkflow from '../components/AIWorkflow.astro';
import ExperienceStrip from '../components/ExperienceStrip.astro';
import Footer from '../components/Footer.astro';

const title = 'Giacomo Di Muro — Business Strategy & Analytics';
const description = 'Business strategy, analytics and technology applied to structured decisions and execution.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F0E8" />
    <title>{title}</title>
  </head>
  <body>
    <Navigation />

    <main>
      <section class="container hero-v2">
        <HeroIntro />

        <div class="hero-project" id="work">
          <div class="hero-project-head">
            <div>
              <p class="eyebrow">01 / 03 · Commercial Strategy</p>
              <h2 class="hero-project-title">Commercial Opportunity Prioritisation</h2>
              <p class="hero-project-meta">Global beverage company · Market Analytics · GTM · Prioritisation</p>
            </div>
            <a class="editorial-link hero-project-link" href="#case-01">Explore <span aria-hidden="true">↘</span></a>
          </div>

          <div class="hero-map-shell" id="case-01">
            <OpportunityMap />
            <div class="hero-map-metric">
              <strong>12k+</strong>
              <span>locations analysed</span>
            </div>
          </div>

          <div class="hero-project-foot">
            <div>
              <strong>Business question</strong>
              <p>Which commercial opportunities should be prioritised?</p>
            </div>
            <div>
              <strong>Decision enabled</strong>
              <p>Created a structured basis to identify and prioritise commercially attractive opportunities.</p>
            </div>
          </div>
          <p class="confidentiality-note">Visual reconstruction using synthetic data for confidentiality.</p>
        </div>
      </section>

      <section class="manifesto">
        <div class="container manifesto-grid">
          <p class="eyebrow">Selected work</p>
          <h2>Three examples. One pattern: turning <span>ambiguity into evidence</span> and evidence into decisions.</h2>
        </div>
      </section>

      <section class="chapter chapter-light" id="retail-performance">
        <div class="container chapter-grid">
          <div class="chapter-copy">
            <p class="eyebrow chapter-number">02 / 03 · Commercial Analytics</p>
            <h2 class="chapter-title">Retail Performance Intelligence</h2>
            <p class="chapter-client">Leading consumer brand · Retail Strategy · Profitability · Customer Analytics</p>

            <p class="chapter-question">How can retail performance patterns inform better network and commercial decisions?</p>
            <p class="chapter-output">Translated store- and customer-level performance patterns into structured commercial and network insights.</p>
          </div>

          <div class="chapter-visual">
            <RetailScatter />
            <div class="metrics-row">
              <div class="metric"><strong>700k+</strong><span>records analysed</span></div>
              <div class="metric"><strong>150+</strong><span>stores</span></div>
            </div>
            <p class="confidentiality-note">Visual reconstruction using synthetic data for confidentiality.</p>
          </div>
        </div>
      </section>

      <section class="chapter chapter-dark" id="ai-workflows">
        <div class="container chapter-grid">
          <div class="chapter-copy">
            <p class="eyebrow chapter-number">03 / 03 · Applied AI</p>
            <h2 class="chapter-title">AI-enabled Consulting Workflows</h2>
            <p class="chapter-client">Internal transformation / Consulting organisation</p>

            <p class="chapter-question">How can recurring consulting workflows be redesigned using AI without losing business judgement?</p>
            <p class="chapter-output">AI is positioned as one layer in a controlled process: structured analysis first, consultant validation before decision.</p>
            <p class="confidentiality-note">Selected as AI Champion — Consumer</p>
          </div>

          <div class="chapter-visual">
            <AIWorkflow />
          </div>
        </div>
      </section>

      <ExperienceStrip />
    </main>

    <Footer />
  </body>
</html>
