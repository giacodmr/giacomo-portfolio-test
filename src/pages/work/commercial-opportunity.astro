---
import '../../styles/design-tokens.css';
import '../../styles/global.css';
import '../../styles/commercial-opportunity.css';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import CommercialOpportunityMap from '../../components/CommercialOpportunityMap.astro';

const approach = [
  { number: '01', icon: '◎', title: 'Frame the network', copy: 'Define the scope and create a consistent view of the commercial universe.' },
  { number: '02', icon: '▥', title: 'Read market signals', copy: 'Bring together market, commercial and competitive information across locations.' },
  { number: '03', icon: '◫', title: 'Assess potential', copy: 'Translate multiple signals into a structured view of relative opportunity.' },
  { number: '04', icon: '⇄', title: 'Compare opportunities', copy: 'Prioritise locations through a consistent commercial comparison logic.' },
  { number: '05', icon: '→', title: 'Translate into action', copy: 'Turn the analysis into decision-support outputs and go-to-market priorities.' },
];

const contribution = [
  'Supported the analytical and commercial prioritisation approach across a large location network.',
  'Performed market and competitor analysis to interpret local opportunity signals.',
  'Supported revenue / sales-potential estimation and profitability thinking within the assessment.',
  'Translated findings into management-ready decision-support outputs and go-to-market priorities.',
];

const decisions = [
  'Compare opportunities on a consistent basis',
  'Surface commercially attractive areas',
  'Support targeting and commercial focus',
  'Create a structured basis for go-to-market decisions',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f8fa" />
    <title>Commercial Opportunity Prioritisation — Giacomo Di Muro</title>
  </head>

  <body class="commercial-page">
    <Navigation />

    <main class="co-page">
      <section class="container case-hero">
        <div class="hero-copy">
          <p class="co-kicker">01 / 03 · Commercial Strategy</p>
          <h1>Commercial Opportunity Prioritisation</h1>
          <p class="hero-client">Global beverage company</p>
          <p class="hero-summary">
            A data-driven approach to structure and prioritise commercial opportunities across Italy,
            combining market, commercial, competitive and contextual signals into a clearer basis for action.
          </p>

          <div class="hero-tags" aria-label="Capabilities">
            <span>Commercial strategy</span>
            <span>Market analytics</span>
            <span>GTM</span>
            <span>Prioritisation</span>
          </div>
        </div>

        <aside class="hero-evidence" aria-label="Project evidence">
          <div class="hero-kpi">
            <strong>12k+</strong>
            <span>locations analysed</span>
          </div>

          <dl class="fact-list">
            <div><dt>Market</dt><dd>Italy · 9 markets</dd></div>
            <div><dt>Focus</dt><dd>Commercial opportunity prioritisation</dd></div>
            <div><dt>Output</dt><dd>Decision-support view for commercial focus</dd></div>
          </dl>

          <p class="hero-note">Client identity and visual scoring values are adapted for confidentiality.</p>
        </aside>
      </section>

      <section class="container challenge-section">
        <div class="challenge-question">
          <p class="section-kicker">Business question</p>
          <h2>Which commercial opportunities should be prioritised?</h2>
        </div>

        <div class="challenge-context">
          <p class="section-kicker">Context</p>
          <h3>Not every location represents the same strategic or commercial opportunity.</h3>
          <p>
            The work brought together market, territorial, competitive and commercial information to create
            a more structured way to compare locations and decide where commercial attention should go first.
          </p>
        </div>
      </section>

      <section class="container approach-section">
        <div class="section-head">
          <p class="section-kicker">Approach</p>
          <p>A five-step logic moved the work from a fragmented location universe to comparable commercial priorities.</p>
        </div>

        <div class="approach-grid">
          {approach.map((step) => (
            <article class="approach-step">
              <span class="step-number">{step.number}</span>
              <span class="step-icon" aria-hidden="true">{step.icon}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="container analysis-section">
        <div class="analysis-heading">
          <div>
            <p class="section-kicker">Analytical work</p>
            <h2>From thousands of locations to a comparable opportunity view.</h2>
          </div>
          <p>
            The analysis combined commercial signals into one consistent comparison layer, helping surface
            where deeper attention and field action could be most valuable.
          </p>
        </div>

        <CommercialOpportunityMap />

        <div class="artifact-grid">
          <article class="artifact-card">
            <div class="artifact-header">
              <div>
                <span>Opportunity matrix</span>
                <h3>Compare markets on two commercial dimensions.</h3>
              </div>
              <em>Illustrative reconstruction</em>
            </div>

            <svg class="opportunity-matrix" viewBox="0 0 520 310" role="img" aria-label="Illustrative opportunity matrix">
              <line class="axis" x1="56" y1="256" x2="484" y2="256" />
              <line class="axis" x1="56" y1="256" x2="56" y2="38" />
              <line class="grid" x1="56" y1="147" x2="484" y2="147" />
              <line class="grid" x1="270" y1="256" x2="270" y2="38" />
              <text class="axis-label" x="270" y="294">Commercial potential →</text>
              <text class="axis-label vertical" x="18" y="150">Market attractiveness →</text>
              <circle class="matrix-dot context" cx="145" cy="205" r="8" />
              <circle class="matrix-dot secondary" cx="224" cy="176" r="10" />
              <circle class="matrix-dot secondary" cx="325" cy="118" r="11" />
              <circle class="matrix-dot focus" cx="402" cy="82" r="13" />
              <text class="dot-label" x="420" y="78">Priority cluster</text>
            </svg>
          </article>

          <article class="artifact-card dark">
            <div class="artifact-header">
              <div>
                <span>Prioritisation logic</span>
                <h3>Multiple signals, one decision-support view.</h3>
              </div>
              <em>Conceptual view</em>
            </div>

            <div class="logic-flow">
              <div class="logic-signals">
                <div class="logic-signal"><span>01</span><p><strong>Commercial</strong><small>Sales potential · profitability thinking</small></p></div>
                <div class="logic-signal"><span>02</span><p><strong>Market</strong><small>Local attractiveness · demand signals</small></p></div>
                <div class="logic-signal"><span>03</span><p><strong>Context</strong><small>Competition · territory · execution factors</small></p></div>
              </div>
              <div class="logic-arrow" aria-hidden="true"><span>→</span></div>
              <div class="logic-output">
                <span>Decision view</span>
                <strong>Comparable commercial priorities</strong>
                <p>A clearer, repeatable basis for focused action.</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="container contribution-section">
        <div class="contribution-copy">
          <p class="section-kicker">My contribution</p>
          <h2>Turning analysis into commercial decision support.</h2>
          <p>My role focused on analytical structure, commercial interpretation and management-ready outputs within the broader project team.</p>
        </div>

        <ol class="contribution-list">
          {contribution.map((item) => <li>{item}</li>)}
        </ol>
      </section>

      <section class="decision-band">
        <div class="container decision-inner">
          <div class="decision-copy">
            <p class="section-kicker">Decision enabled</p>
            <h2>A clearer basis for deciding where commercial attention should go first.</h2>
            <p>The analysis created a structured way to move from thousands of locations to a more focused set of commercial priorities.</p>
          </div>

          <div class="decision-list">
            {decisions.map((item, index) => (
              <div><span>0{index + 1}</span><p>{item}</p></div>
            ))}
          </div>
        </div>
      </section>

      <section class="container evidence-section">
        <div class="evidence-head">
          <p class="section-kicker">Evidence</p>
          <p>Selected factual indicators that can be shared publicly.</p>
        </div>

        <div class="evidence-grid">
          <div><strong>12k+</strong><span>locations analysed</span></div>
          <div><strong>9</strong><span>Italian markets in scope</span></div>
          <div><strong>Market + commercial</strong><span>signals combined for prioritisation</span></div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
