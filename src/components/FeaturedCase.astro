---
import HomeOpportunityMap from './HomeOpportunityMap.astro';
import PrimerProjectMeta from './primer/PrimerProjectMeta.jsx';
---

<article id="work" class="featured-case">
  <div class="featured-case-topline">
    <span>01 / 03</span>
    <span>Featured case · Commercial strategy</span>
  </div>

  <div class="featured-case-heading">
    <div>
      <p class="featured-client">Global beverage company</p>
      <h2>Commercial Opportunity Prioritisation</h2>
    </div>

    <a class="featured-case-link" href="/work/commercial-opportunity" aria-label="View Commercial Opportunity Prioritisation case study">
      View case study <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="featured-map-shell">
    <HomeOpportunityMap />
    <span class="synthetic-note">Synthetic visual reconstruction</span>
  </div>

  <div class="featured-case-bottom">
    <div class="featured-question">
      <span>Business question</span>
      <strong>Which commercial opportunities should be prioritised?</strong>
    </div>

    <div class="featured-output">
      <span>Decision enabled</span>
      <p>A structured basis for commercial focus across a large opportunity universe.</p>
    </div>

    <PrimerProjectMeta
      tags={['Commercial Strategy', 'Market Analytics', 'GTM']}
      stats={[{ value: '12k+', label: 'locations analysed' }]}
      href="/work/commercial-opportunity"
    />
  </div>
</article>

<style>
  .featured-case {
    display: grid;
    grid-template-rows: auto auto minmax(330px, 1fr) auto;
    min-height: 100%;
    border-left: 1px solid var(--border);
    background: var(--surface);
  }

  .featured-case-topline,
  .featured-case-heading,
  .featured-case-bottom {
    padding-inline: clamp(26px, 3.2vw, 50px);
  }

  .featured-case-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: .74rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .featured-case-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    padding-top: 30px;
    padding-bottom: 30px;
  }

  .featured-client {
    margin: 0 0 11px;
    color: var(--text-secondary);
    font-size: .86rem;
  }

  .featured-case h2 {
    max-width: 650px;
    margin: 0;
    font-size: clamp(2rem, 3.05vw, 3.75rem);
    line-height: .96;
    letter-spacing: -.05em;
  }

  .featured-case-link {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    flex: 0 0 auto;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--ds-radius-sm);
    color: var(--text);
    background: var(--surface);
    font-size: .84rem;
    font-weight: 600;
    transition: border-color var(--ds-motion-fast) ease, color var(--ds-motion-fast) ease, background var(--ds-motion-fast) ease;
  }
  .featured-case-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--surface-soft);
  }

  .featured-map-shell {
    position: relative;
    min-height: 350px;
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-soft);
  }

  .featured-map-shell :global(.home-opportunity-map) {
    min-height: 100%;
    padding-block: 8px;
  }

  .synthetic-note {
    position: absolute;
    right: 18px;
    bottom: 14px;
    padding: 6px 9px;
    border: 1px solid var(--border);
    border-radius: var(--ds-radius-xs);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    color: var(--text-tertiary);
    font-size: .68rem;
    backdrop-filter: blur(8px);
  }

  .featured-case-bottom {
    display: grid;
    grid-template-columns: .95fr .95fr 1.15fr;
    gap: 0;
    padding-top: 0;
    padding-bottom: 0;
  }

  .featured-question,
  .featured-output,
  .featured-case-bottom :global(.primer-project-meta) {
    min-width: 0;
    min-height: 190px;
    padding: 32px 28px;
  }

  .featured-question,
  .featured-output {
    border-right: 1px solid var(--border);
  }

  .featured-question span,
  .featured-output span {
    display: block;
    margin-bottom: 12px;
    color: var(--text-secondary);
    font-size: .72rem;
    font-weight: 650;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .featured-question strong {
    display: block;
    font-size: 1.02rem;
    line-height: 1.42;
  }

  .featured-output p {
    margin: 0;
    color: var(--text-secondary);
    font-size: .9rem;
    line-height: 1.58;
  }

  .featured-case-bottom :global(.primer-project-meta) {
    gap: 16px;
    margin-top: 0;
    padding-top: 30px;
  }

  .featured-case-bottom :global(.primer-stats) {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .featured-case-bottom :global(.primer-project-meta > a),
  .featured-case-bottom :global(.primer-project-meta > button) {
    display: inline-flex;
    justify-self: start;
    margin-top: 2px;
  }

  @media (max-width: 1080px) {
    .featured-case { border-left: 0; border-top: 1px solid var(--border); }
  }

  @media (max-width: 760px) {
    .featured-case-heading { align-items: flex-start; flex-direction: column; }
    .featured-case-bottom { grid-template-columns: 1fr; }
    .featured-question,
    .featured-output { border-right: 0; border-bottom: 1px solid var(--border); }
    .featured-case-topline { align-items: flex-start; flex-direction: column; gap: 6px; }
    .featured-map-shell { min-height: 310px; }
    .featured-question,
    .featured-output,
    .featured-case-bottom :global(.primer-project-meta) { min-height: auto; }
  }
</style>
