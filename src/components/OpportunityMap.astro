<div class="opportunity-map" data-opportunity-map>
  <div class="map-controls" aria-label="Opportunity filters">
    <button type="button" class="is-active" data-filter="all">All</button>
    <button type="button" data-filter="high">High</button>
    <button type="button" data-filter="medium">Medium</button>
    <button type="button" data-filter="low">Context</button>
  </div>

  <svg viewBox="0 0 900 650" role="img" aria-labelledby="map-title map-desc" preserveAspectRatio="xMidYMid meet">
    <title id="map-title">Synthetic commercial opportunity map</title>
    <desc id="map-desc">Abstracted Italy map with synthetic commercial opportunity points. Hover or focus highlighted locations for details.</desc>

    <defs>
      <filter id="soft-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <g class="grid-lines" aria-hidden="true">
      <path d="M70 130H830M70 260H830M70 390H830M70 520H830" />
      <path d="M180 70V590M360 70V590M540 70V590M720 70V590" />
    </g>

    <g class="territory" aria-hidden="true">
      <path d="M441 72c37 38 46 76 35 110-10 30 10 60 42 82 32 22 47 50 42 77-4 24 14 48 53 72 48 29 69 57 55 83-11 22-43 21-67-5-20-21-40-14-46 5-7 22 13 49 38 68-27 15-54 12-80-8-29-22-49-49-70-71-18-19-43-24-68-11-30 17-53 8-63-22-10-35-28-67-51-91-24-25-42-60-39-95 2-32 11-63 26-94z" />
      <path d="M330 454c29 16 47 47 43 75-4 32-31 50-61 39-26-10-38-39-24-65 11-23 24-39 42-49z" />
      <path d="M632 492c36-1 70 12 91 34-24 22-53 34-85 36-27 2-51-8-66-28 12-22 32-36 60-42z" />
    </g>

    <g class="points">
      <circle class="point low" cx="365" cy="151" r="5" data-level="low" />
      <circle class="point low" cx="399" cy="126" r="4" data-level="low" />
      <circle class="point low" cx="478" cy="128" r="5" data-level="low" />
      <circle class="point low" cx="505" cy="180" r="4" data-level="low" />
      <circle class="point low" cx="409" cy="205" r="5" data-level="low" />
      <circle class="point low" cx="462" cy="234" r="5" data-level="low" />
      <circle class="point low" cx="508" cy="279" r="5" data-level="low" />
      <circle class="point low" cx="535" cy="324" r="4" data-level="low" />
      <circle class="point low" cx="571" cy="369" r="5" data-level="low" />
      <circle class="point low" cx="606" cy="416" r="5" data-level="low" />
      <circle class="point low" cx="643" cy="459" r="4" data-level="low" />
      <circle class="point low" cx="690" cy="520" r="5" data-level="low" />
      <circle class="point low" cx="344" cy="508" r="5" data-level="low" />
      <circle class="point low" cx="424" cy="287" r="4" data-level="low" />
      <circle class="point low" cx="491" cy="355" r="4" data-level="low" />

      <circle class="point medium" cx="389" cy="167" r="7" data-level="medium" />
      <circle class="point medium" cx="432" cy="152" r="7" data-level="medium" />
      <circle class="point medium" cx="449" cy="225" r="7" data-level="medium" />
      <circle class="point medium" cx="485" cy="264" r="7" data-level="medium" />
      <circle class="point medium" cx="520" cy="310" r="7" data-level="medium" />
      <circle class="point medium" cx="552" cy="353" r="7" data-level="medium" />
      <circle class="point medium" cx="588" cy="397" r="7" data-level="medium" />
      <circle class="point medium" cx="621" cy="445" r="7" data-level="medium" />

      <circle class="point high interactive" tabindex="0" role="button" aria-label="Milan, high opportunity, score 92" cx="420" cy="143" r="10" data-level="high" data-city="Milan, IT" data-score="92" data-cluster="A" />
      <circle class="point high interactive" tabindex="0" role="button" aria-label="Bologna, high opportunity, score 86" cx="472" cy="250" r="10" data-level="high" data-city="Bologna, IT" data-score="86" data-cluster="A" />
      <circle class="point high interactive" tabindex="0" role="button" aria-label="Rome, high opportunity, score 89" cx="570" cy="383" r="11" data-level="high" data-city="Rome, IT" data-score="89" data-cluster="A" />
      <circle class="point high interactive" tabindex="0" role="button" aria-label="Bari, high opportunity, score 81" cx="648" cy="470" r="9" data-level="high" data-city="Bari, IT" data-score="81" data-cluster="B" />
    </g>

    <g class="city-labels" aria-hidden="true">
      <text x="328" y="148">Turin</text>
      <text x="435" y="132">Milan</text>
      <text x="488" y="243">Bologna</text>
      <text x="588" y="379">Rome</text>
      <text x="664" y="466">Bari</text>
    </g>
  </svg>

  <div class="map-tooltip" data-tooltip aria-live="polite">
    <span data-tooltip-city>Milan, IT</span>
    <strong><b data-tooltip-score>92</b> opportunity score</strong>
    <small>Priority cluster <b data-tooltip-cluster>A</b></small>
  </div>

  <div class="map-caption" aria-hidden="true">Synthetic opportunity landscape · Italy</div>
</div>

<script>
  document.querySelectorAll('[data-opportunity-map]').forEach((map) => {
    const buttons = map.querySelectorAll('[data-filter]');
    const points = map.querySelectorAll('.point');
    const interactives = map.querySelectorAll('.interactive');
    const tooltip = map.querySelector('[data-tooltip]');
    const city = map.querySelector('[data-tooltip-city]');
    const score = map.querySelector('[data-tooltip-score]');
    const cluster = map.querySelector('[data-tooltip-cluster]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        buttons.forEach((b) => b.classList.remove('is-active'));
        button.classList.add('is-active');
        points.forEach((point) => {
          const matches = filter === 'all' || point.getAttribute('data-level') === filter;
          point.classList.toggle('is-muted', !matches);
        });
      });
    });

    const show = (point) => {
      interactives.forEach((p) => p.classList.toggle('is-selected', p === point));
      if (city) city.textContent = point.getAttribute('data-city') || '';
      if (score) score.textContent = point.getAttribute('data-score') || '';
      if (cluster) cluster.textContent = point.getAttribute('data-cluster') || '';
      tooltip?.classList.add('is-visible');
    };

    interactives.forEach((point) => {
      point.addEventListener('mouseenter', () => show(point));
      point.addEventListener('focus', () => show(point));
    });
  });
</script>

<style>
  .opportunity-map { position:absolute; inset:0; overflow:hidden; }
  svg { width:100%; height:100%; padding:38px 18px 14px; }
  .grid-lines path { fill:none; stroke:rgba(23,63,48,.08); stroke-width:1; }
  .territory path { fill:rgba(250,250,244,.42); stroke:rgba(23,63,48,.22); stroke-width:1.2; }
  .point { transform-box:fill-box; transform-origin:center; transition:opacity .24s ease, transform .24s ease, filter .24s ease; }
  .point.low { fill:#bbc6bd; opacity:.62; }
  .point.medium { fill:#6f927b; opacity:.82; }
  .point.high { fill:#173f30; stroke:#edf1ea; stroke-width:3; cursor:pointer; }
  .point.interactive:hover, .point.interactive:focus, .point.is-selected { transform:scale(1.45); filter:url(#soft-glow); opacity:1; }
  .point.is-muted { opacity:.09; }
  .city-labels text { fill:#647067; font:500 12px Inter, sans-serif; letter-spacing:.02em; }
  .map-controls { position:absolute; z-index:6; left:28px; top:28px; display:flex; gap:6px; padding:6px; border:1px solid rgba(16,20,16,.1); border-radius:999px; background:rgba(248,246,240,.72); backdrop-filter:blur(12px); }
  .map-controls button { border:0; background:transparent; color:#667067; padding:7px 11px; border-radius:999px; font-size:11px; cursor:pointer; transition:.2s ease; }
  .map-controls button.is-active { background:#173f30; color:#f4f2ec; }
  .map-tooltip { position:absolute; z-index:6; left:clamp(22px,4vw,56px); bottom:clamp(52px,6vw,78px); display:grid; gap:4px; min-width:190px; padding:17px 18px; border:1px solid rgba(16,20,16,.1); border-radius:14px; background:rgba(248,246,240,.88); backdrop-filter:blur(14px); box-shadow:0 18px 50px rgba(16,20,16,.08); opacity:.88; transition:transform .24s ease, opacity .24s ease; }
  .map-tooltip.is-visible { opacity:1; transform:translateY(-3px); }
  .map-tooltip span { font-size:11px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:#657067; }
  .map-tooltip strong { font-size:16px; font-weight:500; }
  .map-tooltip small { color:#657067; }
  .map-caption { position:absolute; right:28px; bottom:22px; color:#7a847b; font-size:10px; letter-spacing:.08em; text-transform:uppercase; }
  @media (max-width:700px) {
    .map-controls { top:18px; left:18px; }
    .map-tooltip { left:18px; bottom:46px; min-width:168px; }
    .city-labels { display:none; }
  }
</style>
