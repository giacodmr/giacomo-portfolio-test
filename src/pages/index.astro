---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import HeroIntro from '../components/HeroIntro.astro';
import OpportunityMap from '../components/OpportunityMap.astro';
import RetailScatter from '../components/RetailScatter.astro';
import AIWorkflow from '../components/AIWorkflow.astro';
import ExperienceStrip from '../components/ExperienceStrip.astro';
import Footer from '../components/Footer.astro';

const title = 'Giacomo Di Muro — Business Strategy & Analytics';
const description = 'Business strategy, analytics and technology applied to structured decisions and execution.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F7F3" />
    <title>{title}</title>
  </head>
  <body>
    <Navigation />

    <main>
      <div class="container hero-shell">
        <HeroIntro />

        <section class="featured-case" aria-labelledby="featured-title">
          <div class="case-heading">
            <p class="eyebrow">01 / 03 · Commercial Strategy</p>
            <h2 id="featured-title" class="case-title">Commercial Opportunity Prioritisation</h2>
            <p class="case-client">Global beverage company</p>
            <p class="case-tags">Commercial Strategy / Market Analytics / GTM / Prioritisation</p>
          </div>

          <div class="visual-frame">
            <OpportunityMap />
          </div>

          <div class="case-evidence">
            <div>
              <span class="metric-value">12k+</span>
              <span class="metric-label">locations analysed</span>
            </div>

            <div class="business-copy">
              <div>
                <strong>Business question</strong>
                <p>Which commercial opportunities should be prioritised?</p>
              </div>
              <div>
                <strong>Output / decision</strong>
                <p>Created a structured basis to identify and prioritise commercially attractive opportunities.</p>
              </div>
            </div>
          </div>

          <p class="confidentiality-note">Visual reconstruction using synthetic data for confidentiality.</p>

          <div class="case-cta">
            <a class="editorial-link" href="#commercial-opportunity">
              View case study <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </div>

      <section id="work" class="work-section">
        <div class="container">
          <div class="section-label">
            <p class="eyebrow">Selected Work</p>
            <p class="eyebrow">02 — 03</p>
          </div>

          <article id="retail-performance" class="project-grid" aria-labelledby="retail-title">
            <div class="project-copy">
              <p class="eyebrow">02 / 03 · Commercial Analytics</p>
              <h2 id="retail-title" class="case-title">Retail Performance Intelligence</h2>
              <p class="case-client">Leading consumer brand</p>
              <p class="case-tags">Commercial Analytics / Retail Strategy / Profitability / Customer Analytics</p>

              <p class="project-question">How can retail performance patterns inform better network and commercial decisions?</p>
              <p class="project-output">
                Translated store- and customer-level performance patterns into structured commercial and network insights.
              </p>

              <div class="case-cta" style="justify-content:flex-start">
                <a class="editorial-link" href="#retail-performance">
                  View case study <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <div class="project-visual">
              <RetailScatter />
              <div class="metric-strip">
                <div>
                  <span class="metric-value">700k+</span>
                  <span class="metric-label">records analysed</span>
                </div>
                <div>
                  <span class="metric-value">150+</span>
                  <span class="metric-label">stores</span>
                </div>
              </div>
              <p class="confidentiality-note">Visual reconstruction using synthetic data for confidentiality.</p>
            </div>
          </article>
        </div>
      </section>

      <section id="ai-workflows" class="work-section">
        <div class="container">
          <div class="project-grid">
            <div class="project-copy">
              <p class="eyebrow">03 / 03 · Applied AI</p>
              <h2 class="case-title">AI-enabled Consulting Workflows</h2>
              <p class="case-client">Internal transformation / Consulting organisation</p>
              <p class="case-tags">Applied AI / Process Redesign / Automation / Transformation</p>

              <p class="project-question">How can recurring consulting workflows be redesigned using AI to increase structure and quality?</p>
              <p class="project-output">
                Designed AI-supported workflows that combine automated analysis with structured consultant review and business context.
              </p>
              <p class="confidentiality-note">Selected as AI Champion — Consumer</p>

              <div class="case-cta" style="justify-content:flex-start">
                <a class="editorial-link" href="#ai-workflows">
                  View case study <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <div class="project-visual">
              <AIWorkflow />
            </div>
          </div>
        </div>
      </section>

      <ExperienceStrip />
    </main>

    <Footer />
  </body>
</html>
