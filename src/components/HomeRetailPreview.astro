    transform-origin: bottom;
    transition:
      transform 520ms var(--ds-ease, ease),
      filter var(--ds-motion-fast, 160ms) ease;
  }
  .retail-report.is-ready .histogram i { transform: scaleY(1); }
  .distribution-panel.is-active .histogram i.focus,
  .distribution-panel.is-active .histogram i.focus-strong { filter: saturate(1.18) brightness(.96); }

  .histogram i:nth-child(4), .histogram i:nth-child(5), .histogram i:nth-child(6) { background: color-mix(in srgb, var(--ds-data-secondary, #78a9ff) 55%, var(--ds-data-context, #c1c7cd)); }
  .histogram i.focus { background: var(--ds-data-secondary, #78a9ff); }
  .histogram i.focus-strong { background: var(--ds-data-focus, #0f62fe); }

  .distribution-axis, .dotplot-axis { display: flex; justify-content: space-between; margin-top: 8px; color: var(--ds-subtle, #6e7781); font-family: var(--ds-font-sans, 'IBM Plex Sans', sans-serif); font-size: .54rem; }

  .horizontal-bars { display: grid; gap: 13px; padding-top: 20px; min-height: 165px; }
  .hbar-row { display: grid; grid-template-columns: 34px 1fr 29px; align-items: center; gap: 8px; min-width: 0; }
  .hbar-row > span, .hbar-row > strong { color: var(--ds-subtle, #6e7781); font-family: var(--ds-font-sans, 'IBM Plex Sans', sans-serif); font-size: .58rem; font-weight: 500; }
  .hbar-row > strong { color: var(--ds-ink, #1f2328); text-align: right; font-weight: 600; }
