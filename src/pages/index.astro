---
const title = 'Giacomo Portfolio Test';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Giacomo Portfolio deployment test" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <section class="card">
        <p class="eyebrow">Astro + GitHub + Vercel</p>
        <h1>Hello World</h1>
        <h2>Giacomo Portfolio Test</h2>
        <p class="status">Static deployment test</p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #f7f8fb;
    color: #111827;
  }

  :global(body) {
    margin: 0;
  }

  main {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
  }

  .card {
    width: min(620px, 100%);
    padding: 56px 40px;
    text-align: center;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    box-shadow: 0 18px 50px rgba(17, 24, 39, 0.08);
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #64748b;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  h2 {
    margin: 18px 0 0;
    font-size: clamp(1.25rem, 4vw, 2rem);
    font-weight: 500;
    color: #475569;
  }

  .status {
    display: inline-block;
    margin: 32px 0 0;
    padding: 8px 12px;
    border-radius: 999px;
    background: #f1f5f9;
    font-size: 0.85rem;
    color: #475569;
  }
</style>
