---
import '../styles/design-tokens.css';
import '../styles/global.css';
import '../styles/home.css';
import Navigation from '../components/Navigation.astro';
import HeroIntro from '../components/HeroIntro.astro';
import ArchitecturalVisual from '../components/ArchitecturalVisual.astro';
import HomeOpportunityMap from '../components/HomeOpportunityMap.astro';
import HomeRetailPreview from '../components/HomeRetailPreview.astro';
import AIWorkflow from '../components/AIWorkflow.astro';
import ExperienceStrip from '../components/ExperienceStrip.astro';
import Footer from '../components/Footer.astro';

const title = 'Giacomo Di Muro — Business Strategy & Analytics';
const description = 'Business strategy, analytics and applied AI for structured business decisions.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f8fa" />
    <title>{title}</title>
  </head>

  <body class="home-page">
    <Navigation />

    <main>
      <section class="hero-section">
        <div class="container hero-grid">
          <HeroIntro />
          <ArchitecturalVisual />
        </div>
      </section>

      <section id="work" class="selected-work">
        <div class="container">
          <header class="work-intro" data-reveal>
            <div class="work-intro-primary">
              <p class="eyebrow">Selected projects</p>
              <h2>My Work</h2>
              <p>Turning complex data into clear insights and measurable impact.</p>
            </div>

            <div class="work-intro-secondary">
              <p>
                A selection of projects across strategy, analytics and AI,
                delivering real business value in global and complex environments.
              </p>
              <div class="work-capabilities" aria-label="Project capability areas">
                <span>Strategy</span><i aria-hidden="true">/</i>
                <span>Analytics</span><i aria-hidden="true">/</i>
                <span>AI</span><i aria-hidden="true">/</i>
                <span>Impact</span>
              </div>
            </div>
          </header>

          <article class="project-card project-featured" data-reveal>
            <div class="project-copy project-copy-featured">
              <p class="eyebrow">Featured work · 01 / 03</p>
              <h2>Commercial Opportunity Prioritisation</h2>
              <p class="project-client">Global beverage company</p>
              <p class="project-description">
                Identified and prioritised commercially attractive locations using market analytics,
                geospatial analysis and a structured scoring approach.
              </p>

              <div class="tag-list" aria-label="Capabilities">
                <span>Commercial strategy</span>
                <span>Market analytics</span>
                <span>GTM</span>
              </div>

              <a class="project-link" href="/work/commercial-opportunity">
                View project <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="featured-map">
              <HomeOpportunityMap />
            </div>

            <aside class="project-stat-panel" aria-label="Project evidence">
              <p class="project-index">01 / 03</p>

              <div class="primary-stat">
                <strong>500k+</strong>
                <span>points of consumption analysed</span>
              </div>

              <div class="selected-market-card" aria-live="polite">
                <span class="selected-market-kicker">Selected market</span>
                <strong data-feature-market>Milan</strong>
                <p>Priority score <b data-feature-score>92</b></p>
                <em data-feature-priority>High opportunity</em>
              </div>

              <div class="legend" aria-label="Opportunity priority legend">
                <span><i class="legend-dot high"></i>High priority</span>
                <span><i class="legend-dot medium"></i>Medium priority</span>
                <span><i class="legend-dot low"></i>Lower priority</span>
              </div>

              <p class="stat-note">From analysis to opportunity across Italy.</p>
            </aside>
          </article>

          <div class="secondary-projects">
            <article class="project-card retail-card" data-reveal>
              <div class="project-card-head">
                <div>
                  <p class="eyebrow">02 / 03 · Retail Analytics</p>
                  <h2>Retail Performance Intelligence</h2>
                  <p class="project-client">Leading consumer brand</p>
                </div>

                <div class="compact-stats" aria-label="Retail project evidence">
                  <div><strong>700k+</strong><span>records analysed</span></div>
                  <div><strong>150+</strong><span>stores</span></div>
                </div>
              </div>

              <p class="project-description compact">
                Store- and customer-level performance patterns translated into network and commercial insights.
              </p>

              <HomeRetailPreview />

              <div class="card-footer-row">
                <div class="tag-list" aria-label="Capabilities">
                  <span>Retail strategy</span>
                  <span>Customer analytics</span>
                  <span>Network strategy</span>
                </div>

                <a class="project-link" href="/work/retail-performance">
                  View project <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>

            <article class="project-card ai-card" data-reveal>
              <div>
                <p class="eyebrow">03 / 03 · Applied AI</p>
                <h2>AI-enabled Consulting Workflows</h2>
                <p class="project-client">Internal transformation / Consulting organisation</p>
                <p class="project-description compact">
                  AI-supported workflows designed around structured analysis, consultant review and decision-ready outputs.
                </p>
              </div>

              <AIWorkflow />

              <div class="ai-card-footer">
                <p>Selected as AI Champion — Consumer</p>
                <a class="project-link project-link-light" href="/work/ai-workflows">
                  View project <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <ExperienceStrip />
    </main>

    <Footer />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('[data-reveal]');

      if (reduceMotion) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12 });

        revealItems.forEach((item, index) => {
          item.style.setProperty('--reveal-delay', `${Math.min(index * 70, 180)}ms`);
          observer.observe(item);
        });
      }

      document.addEventListener('portfolio:map-selection', (event) => {
        const detail = event.detail;
        if (!detail) return;

        const market = document.querySelector('[data-feature-market]');
        const score = document.querySelector('[data-feature-score]');
        const priority = document.querySelector('[data-feature-priority]');

        if (market) market.textContent = detail.city || '';
        if (score) score.textContent = detail.score || '';
        if (priority) priority.textContent = detail.priority || '';
      });
    </script>
  </body>
</html>
