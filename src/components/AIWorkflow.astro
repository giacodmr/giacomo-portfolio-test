<div class="ai-stage" data-ai-stage role="img" aria-label="AI-enabled consulting workflow from business question through data and analysis to human review and decision">
  <div class="stage-label">Controlled AI workflow</div>

  <div class="node node-question" data-node>
    <span>01</span>
    <strong>Business question</strong>
    <small>Objectives · Context · Constraints</small>
  </div>

  <div class="branch branch-left" data-node>
    <div class="mini-node">Data</div>
    <div class="mini-node">Documents</div>
    <div class="mini-node">Context</div>
  </div>

  <div class="flow-line line-a" aria-hidden="true"></div>
  <div class="flow-line line-b" aria-hidden="true"></div>

  <div class="node node-ai" data-node>
    <span>02</span>
    <strong>AI-supported analysis</strong>
    <small>Structure · Analyse · Synthesise</small>
    <i aria-hidden="true"></i>
  </div>

  <div class="flow-line line-c" aria-hidden="true"></div>

  <div class="node node-review" data-node>
    <span>03</span>
    <strong>Consultant review</strong>
    <small>Validate · Refine · Apply business context</small>
  </div>

  <div class="flow-line line-d" aria-hidden="true"></div>

  <div class="node node-output" data-node>
    <span>04</span>
    <strong>Decision / output</strong>
    <small>Insights · Recommendations · Action plan</small>
  </div>

  <p class="human-note">Human judgement remains explicit at the decision boundary.</p>
</div>

<script>
  document.querySelectorAll('[data-ai-stage]').forEach((stage) => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) stage.classList.add('is-visible');
      });
    }, { threshold: 0.3 });
    observer.observe(stage);
  });
</script>

<style>
  .ai-stage {
