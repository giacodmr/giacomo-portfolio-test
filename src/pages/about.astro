---
import '../styles/design-tokens.css';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
  {
    title: 'Commercial Strategy',
    copy: 'Structuring commercial questions, prioritisation logic and decision support around markets, channels and opportunities.'
  },
  {
    title: 'Business Analytics',
    copy: 'Turning large or fragmented datasets into comparable performance views, patterns and management-ready insights.'
  },
  {
    title: 'Transformation',
    copy: 'Connecting analysis to processes, operating choices and practical implementation across teams and stakeholders.'
  },
  {
    title: 'Applied AI',
    copy: 'Using AI as a controlled business capability for structuring, analysing and improving recurring knowledge workflows.'
  }
];

const education = [
  ['LUISS Guido Carli', 'MSc in Management'],
  ['University of Luxembourg', 'Exchange semester · Entrepreneurship & Innovation'],
  ['University of Salerno', 'BSc in Economics and Management']
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="About Giacomo Di Muro — business consultant working across strategy, analytics, transformation and applied AI." />
    <meta name="theme-color" content="#ffffff" />
    <title>About — Giacomo Di Muro</title>
  </head>

  <body>
    <Navigation />

    <main class="about-page">
      <section class="container about-hero">
        <p class="eyebrow">About</p>
        <div class="about-hero-grid">
          <h1>Business thinking, analytical structure and practical execution.</h1>
          <div class="about-intro">
            <p>
              I work on business problems where strategy, data and execution need to come together — from commercial prioritisation and performance analysis to transformation and AI-enabled ways of working.
            </p>
            <p>
              My focus is not the tool itself. It is creating a clearer structure around the problem, understanding what the evidence says and translating it into a decision that can actually be used.
            </p>
          </div>
        </div>
      </section>

      <section class="container current-role">
        <div class="section-label">
          <p class="eyebrow">Current role</p>
          <span>Milan</span>
        </div>
        <div class="role-main">
          <span>JAKALA</span>
          <h2>Business Consultant · Client Strategy</h2>
          <p>Strategy, analytics and transformation work across consumer and commercial topics.</p>
        </div>
        <div class="role-note">
          <span>Additional responsibility</span>
          <strong>Selected as AI Champion — Consumer</strong>
          <p>Supporting practical AI adoption and workflow improvement within the business context.</p>
        </div>
      </section>

      <section class="capability-section">
        <div class="container">
          <div class="capability-head">
            <p class="eyebrow">Selected capability areas</p>
            <h2>Business first. Data and technology as capabilities.</h2>
          </div>

          <div class="capability-grid">
            {capabilities.map((capability, index) => (
              <article>
                <span>0{index + 1}</span>
                <h3>{capability.title}</h3>
                <p>{capability.copy}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="container education-section">
        <div>
          <p class="eyebrow">Education</p>
          <h2>A business foundation with international exposure.</h2>
        </div>

        <div class="education-list">
          {education.map(([institution, degree]) => (
            <div>
              <strong>{institution}</strong>
              <span>{degree}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="container about-work-link">
        <span>Selected work</span>
        <a href="/#work">See how this translates into projects <i aria-hidden="true">→</i></a>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .about-page { background: var(--surface); }
  .about-hero { padding-top: clamp(72px, 9vw, 128px); padding-bottom: clamp(72px, 9vw, 128px); }
  .about-hero-grid {
    display: grid;
    grid-template-columns: 1.5fr .8fr;
    gap: clamp(48px, 7vw, 112px);
    align-items: end;
    margin-top: 28px;
  }
  .about-hero h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(3.2rem, 7vw, 7.2rem);
    line-height: .9;
    letter-spacing: -.06em;
  }
  .about-intro { display: grid; gap: 18px; }
  .about-intro p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }

  .current-role {
    display: grid;
    grid-template-columns: .7fr 1.45fr 1fr;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .section-label,
  .role-main,
  .role-note { padding: 34px 28px; }
  .section-label,
  .role-main { border-right: 1px solid var(--border); }
  .section-label { display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; }
  .section-label span { color: var(--text-secondary); font-size: .8rem; }
  .role-main > span,
  .role-note > span {
    color: var(--text-secondary);
    font-size: .68rem;
    font-weight: 650;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .role-main h2 { margin: 24px 0 14px; font-size: clamp(2rem, 3vw, 3.25rem); line-height: 1; letter-spacing: -.045em; }
  .role-main p,
  .role-note p { margin: 0; color: var(--text-secondary); font-size: .86rem; line-height: 1.6; }
  .role-note { display: flex; flex-direction: column; justify-content: center; gap: 14px; background: var(--surface-soft); }
  .role-note strong { font-size: 1.05rem; }

  .capability-section { padding: clamp(80px, 9vw, 128px) 0; background: var(--surface-soft); }
  .capability-head {
    display: grid;
    grid-template-columns: .8fr 2fr;
    gap: 32px;
    align-items: start;
    margin-bottom: 44px;
  }
  .capability-head h2 { max-width: 760px; margin: 0; font-size: clamp(2.2rem, 4vw, 4.25rem); line-height: .95; letter-spacing: -.05em; }
  .capability-grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border); background: var(--surface); }
  .capability-grid article { min-height: 280px; padding: 28px; }
  .capability-grid article + article { border-left: 1px solid var(--border); }
  .capability-grid article > span { color: var(--text-tertiary); font-size: .68rem; font-weight: 650; }
  .capability-grid h3 { margin: 64px 0 16px; font-size: 1.2rem; }
  .capability-grid p { margin: 0; color: var(--text-secondary); font-size: .8rem; line-height: 1.6; }

  .education-section {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 72px;
    padding-top: clamp(80px, 9vw, 128px);
    padding-bottom: clamp(80px, 9vw, 128px);
  }
  .education-section h2 { max-width: 560px; margin: 20px 0 0; font-size: clamp(2rem, 3.6vw, 3.8rem); line-height: .98; letter-spacing: -.045em; }
  .education-list { border-top: 1px solid var(--border); }
  .education-list div { display: grid; grid-template-columns: 1fr 1.2fr; gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--border); }
  .education-list strong { font-size: .9rem; }
  .education-list span { color: var(--text-secondary); font-size: .84rem; }

  .about-work-link {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 32px;
    border-top: 1px solid var(--border);
  }
  .about-work-link > span { color: var(--text-secondary); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; }
  .about-work-link a { display: inline-flex; gap: 12px; align-items: center; font-size: 1rem; font-weight: 600; }
  .about-work-link a:hover { color: var(--accent); }
  .about-work-link i { font-style: normal; }

  @media (max-width: 900px) {
    .about-hero-grid,
    .current-role,
    .capability-head,
    .education-section { grid-template-columns: 1fr; }
    .section-label { min-height: auto; }
    .section-label,
    .role-main { border-right: 0; border-bottom: 1px solid var(--border); }
    .capability-grid { grid-template-columns: repeat(2, 1fr); }
    .capability-grid article:nth-child(3) { border-left: 0; border-top: 1px solid var(--border); }
    .capability-grid article:nth-child(4) { border-top: 1px solid var(--border); }
  }

  @media (max-width: 620px) {
    .about-hero h1 { font-size: clamp(3rem, 16vw, 4.8rem); }
    .capability-grid { grid-template-columns: 1fr; }
    .capability-grid article + article { border-left: 0; border-top: 1px solid var(--border); }
    .education-list div { grid-template-columns: 1fr; gap: 8px; }
    .about-work-link { align-items: flex-start; flex-direction: column; }
  }
</style>
