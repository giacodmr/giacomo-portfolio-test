  { name: 'Milan', x: 110.6, y: 129.2, score: 92, priority: 'High opportunity', tier: 'high', market: 94, commercial: 88, whitespace: 76, execution: 82, dx: 14, dy: -10, anchor: 'start' },
  { name: 'Turin', x: 56.0, y: 148.5, score: 78, priority: 'Medium opportunity', tier: 'medium', market: 79, commercial: 75, whitespace: 72, execution: 80, dx: -10, dy: -11, anchor: 'end' },
  { name: 'Verona', x: 176.0, y: 130.5, score: 80, priority: 'Medium opportunity', tier: 'medium', market: 82, commercial: 77, whitespace: 73, execution: 79, dx: 10, dy: -12, anchor: 'start' },
  { name: 'Venice', x: 224.1, y: 130.4, score: 81, priority: 'Medium opportunity', tier: 'medium', market: 84, commercial: 79, whitespace: 71, execution: 77, dx: 11, dy: -10, anchor: 'start' },
  { name: 'Bologna', x: 188.8, y: 176.6, score: 83, priority: 'High opportunity', tier: 'high', market: 86, commercial: 81, whitespace: 78, execution: 80, dx: 12, dy: 4, anchor: 'start' },
  { name: 'Florence', x: 185.6, y: 212.1, score: 77, priority: 'Medium opportunity', tier: 'medium', market: 79, commercial: 76, whitespace: 70, execution: 78, dx: 12, dy: 5, anchor: 'start' },
  { name: 'Rome', x: 230.7, y: 303.3, score: 89, priority: 'High opportunity', tier: 'high', market: 91, commercial: 87, whitespace: 79, execution: 84, dx: 12, dy: 4, anchor: 'start' },
  { name: 'Bari', x: 389.6, y: 341.7, score: 84, priority: 'High opportunity', tier: 'high', market: 86, commercial: 83, whitespace: 82, execution: 75, dx: 12, dy: 4, anchor: 'start' },
  { name: 'Cagliari', x: 108.1, y: 434.2, score: 76, priority: 'Medium opportunity', tier: 'medium', market: 78, commercial: 72, whitespace: 80, execution: 69, dx: 12, dy: 4, anchor: 'start' },
];

const network = [
  [83,112,'low'],[96,104,'medium'],[126,104,'low'],[143,116,'low'],[159,105,'medium'],[190,106,'low'],[207,118,'low'],[237,143,'medium'],
  [72,161,'low'],[91,157,'medium'],[120,155,'low'],[145,149,'low'],[161,164,'medium'],[208,164,'low'],[221,180,'low'],[155,188,'medium'],
  [171,199,'low'],[202,199,'medium'],[215,218,'low'],[183,232,'low'],[207,245,'medium'],[230,259,'low'],[248,274,'medium'],[266,288,'low'],
  [285,304,'low'],[305,315,'medium'],[326,326,'low'],[346,337,'low'],[365,349,'medium'],[379,365,'low'],[332,365,'low'],[315,381,'medium'],
  [302,401,'low'],[290,423,'low'],[277,445,'medium'],[260,468,'low'],[245,493,'medium'],[265,510,'low'],[289,520,'low'],[311,526,'medium'],
  [84,365,'low'],[99,381,'medium'],[111,400,'low'],[103,419,'low'],[88,427,'medium'],[81,397,'low'],[117,446,'low'],[95,452,'medium'],
  [245,118,'low'],[258,144,'medium'],[232,192,'low'],[251,222,'low'],[272,249,'medium'],[291,272,'low'],[320,296,'medium'],[356,318,'low']
];
---

<div class="co-map" data-commercial-map>
  <div class="map-canvas">
    <div class="map-head">
      <span>Commercial opportunity map · Italy</span>
      <span>Illustrative reconstruction</span>
    </div>

    <svg class="italy-map" viewBox="0 0 470 610" role="img" aria-labelledby="co-map-title co-map-desc">
      <title id="co-map-title">Commercial opportunity map of Italy</title>
      <desc id="co-map-desc">Geographically accurate simplified outline of Italy, Sicily and Sardinia with nine selectable markets and synthetic priority scores.</desc>

      <g class="territory" aria-hidden="true">
        <path d="M 156.1,59.4 L 178.1,66.3 L 182.3,57.0 L 218.2,48.6 L 226.3,65.6 L 278.3,78.2 L 274.3,102.2 L 283.0,123.0 L 254.1,115.9 L 224.6,133.3 L 226.6,157.5 L 222.2,171.5 L 234.1,196.3 L 268.1,220.9 L 286.4,261.3 L 326.8,300.7 L 355.2,300.4 L 364.1,311.2 L 353.9,321.0 L 386.4,338.6 L 413.1,353.4 L 444.2,378.9 L 448.0,388.0 L 441.2,405.5 L 421.1,382.7 L 389.5,374.7 L 374.2,406.3 L 400.5,424.4 L 396.2,449.9 L 381.0,452.8 L 361.6,494.7 L 346.5,498.5 L 346.6,483.5 L 354.0,457.3 L 361.9,446.9 L 347.7,418.6 L 336.6,393.9 L 321.6,387.8 L 310.8,366.7 L 287.5,357.8 L 271.8,338.2 L 244.9,335.0 L 216.5,313.0 L 183.3,281.2 L 158.6,253.0 L 147.3,204.7 L 129.2,199.0 L 99.7,182.9 L 83.0,189.5 L 62.0,212.2 L 46.9,215.8 L 51.0,194.5 L 31.4,188.3 L 22.0,150.5 L 34.6,135.7 L 23.9,117.3 L 25.4,103.5 L 41.0,114.0 L 58.5,111.6 L 78.9,95.1 L 85.2,102.8 L 102.5,101.3 L 110.4,81.5 L 137.2,87.7 L 153.2,79.4 L 156.1,59.4 Z" />
        <path d="M 312.9,487.0 L 340.5,482.7 L 327.4,521.2 L 332.9,536.3 L 325.2,561.4 L 297.5,543.0 L 279.0,537.8 L 228.3,512.9 L 233.4,487.8 L 275.9,492.3 L 312.9,487.0 Z" />
        <path d="M 93.2,352.3 L 111.3,337.1 L 133.1,371.8 L 128.0,436.5 L 111.5,433.4 L 96.7,449.7 L 83.0,436.7 L 81.5,377.8 L 73.2,349.8 L 93.2,352.3 Z" />
      </g>

      <g class="network" aria-hidden="true">
        {network.map(([x,y,tier]) => <circle cx={x} cy={y} r={tier === 'medium' ? 3 : 2.2} class={`network-point ${tier}`} />)}
      </g>

      <g class="city-layer">
        {cities.map((city, index) => (
          <g
            class={`city ${city.tier} ${index === 0 ? 'is-active' : ''}`}
            tabindex="0"
            role="button"
            aria-label={`${city.name}, illustrative priority score ${city.score}, ${city.priority}`}
            data-city={city.name}
            data-score={city.score}
            data-priority={city.priority}
            data-market={city.market}
            data-commercial={city.commercial}
            data-whitespace={city.whitespace}
            data-execution={city.execution}
            transform={`translate(${city.x} ${city.y})`}
          >
            <circle class="city-halo" r="12" />
            <circle class="city-dot" r="5.3" />
            <text x={city.dx} y={city.dy} text-anchor={city.anchor}>{city.name}</text>
          </g>
        ))}
      </g>
    </svg>

    <div class="map-legend" aria-label="Map legend">
      <span><i class="legend-dot high"></i>High opportunity</span>
      <span><i class="legend-dot medium"></i>Medium</span>
      <span><i class="legend-dot low"></i>Context</span>
    </div>
  </div>

  <aside class="location-panel" aria-live="polite">
    <div class="panel-topline">
      <span>Selected market</span>
      <span data-index>01 / 09</span>
    </div>

    <div class="location-title">
      <h3 data-city-name>Milan</h3>
      <div class="score-row"><strong data-city-score>92</strong><span>/100</span></div>
      <p data-city-priority>High opportunity</p>
    </div>

    <div class="signal-list">
      <div class="signal">
        <div><span>Market potential</span><b data-value-market>94</b></div>
        <i><em data-bar-market style="width:94%"></em></i>
      </div>
      <div class="signal">
        <div><span>Commercial fit</span><b data-value-commercial>88</b></div>
        <i><em data-bar-commercial style="width:88%"></em></i>
      </div>
      <div class="signal">
        <div><span>Competitive whitespace</span><b data-value-whitespace>76</b></div>
        <i><em data-bar-whitespace style="width:76%"></em></i>
      </div>
      <div class="signal">
        <div><span>Ease of execution</span><b data-value-execution>82</b></div>
        <i><em data-bar-execution style="width:82%"></em></i>
      </div>
    </div>

    <div class="panel-note">
      <span>How to read it</span>
      <p>One consistent view makes different markets easier to compare before commercial priorities are translated into action.</p>
    </div>

    <small>Scores and visual values are synthetic for confidentiality.</small>
  </aside>
</div>

<script>
  document.querySelectorAll('[data-commercial-map]').forEach((root) => {
    const cities = [...root.querySelectorAll('.city')];
    const setText = (selector, value) => {
      const node = root.querySelector(selector);
      if (node) node.textContent = String(value);
    };
    const setBar = (selector, value) => {
      const node = root.querySelector(selector);
      if (node instanceof HTMLElement) node.style.width = `${value}%`;
    };

    const activate = (city, index) => {
      cities.forEach((item) => item.classList.toggle('is-active', item === city));
      const data = city.dataset;
      setText('[data-index]', `${String(index + 1).padStart(2, '0')} / ${String(cities.length).padStart(2, '0')}`);
      setText('[data-city-name]', data.city || '');
      setText('[data-city-score]', data.score || '');
      setText('[data-city-priority]', data.priority || '');
      ['market','commercial','whitespace','execution'].forEach((key) => {
        const value = data[key] || '0';
        setText(`[data-value-${key}]`, value);
        setBar(`[data-bar-${key}]`, value);
      });
    };

    cities.forEach((city, index) => {
      city.addEventListener('click', () => activate(city, index));
      city.addEventListener('focus', () => activate(city, index));
      city.addEventListener('mouseenter', () => activate(city, index));
    });
  });
</script>

<style>
  .co-map {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(320px, .75fr);
    min-height: 610px;
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-sm);
    overflow: hidden;
    background: var(--ds-surface);
  }

  .map-canvas {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: var(--ds-space-5) var(--ds-space-6) var(--ds-space-5);
    border-right: 1px solid var(--ds-border-light);
  }

  .map-head,
  .panel-topline {
    display: flex;
    justify-content: space-between;
    gap: var(--ds-space-4);
    color: var(--ds-subtle);
    font: 600 10px/1.2 var(--ds-font-sans);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .italy-map {
    width: min(100%, 630px);
    height: 500px;
    margin: 8px auto 0;
    overflow: visible;
  }

  .territory path {
    fill: var(--ds-forest-100);
    stroke: var(--ds-forest-500);
    stroke-width: .9;
    stroke-opacity: .55;
  }

  .network-point.low { fill: var(--ds-data-low); opacity: .85; }
  .network-point.medium { fill: var(--ds-forest-500); opacity: .8; }

  .city {
    cursor: pointer;
    outline: none;
  }

  .city-halo {
    fill: var(--ds-surface);
    stroke: transparent;
    stroke-width: 1.6;
    opacity: .94;
    transition: r var(--ds-motion-fast) var(--ds-ease), stroke var(--ds-motion-fast) ease;
  }

  .city-dot { fill: var(--ds-forest-800); }
  .city.medium .city-dot { fill: var(--ds-forest-500); }

  .city text {
    fill: var(--ds-ink);
    font: 500 11px/1 var(--ds-font-sans);
    paint-order: stroke;
    stroke: var(--ds-surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .city:hover .city-halo,
  .city:focus-visible .city-halo,
  .city.is-active .city-halo {
    r: 14px;
    stroke: var(--ds-forest-800);
  }

  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-5);
    margin-top: auto;
    color: var(--ds-muted);
    font: 500 11px/1.2 var(--ds-font-sans);
  }

  .map-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .legend-dot.high { background: var(--ds-forest-800); }
  .legend-dot.medium { background: var(--ds-forest-500); }
  .legend-dot.low { background: var(--ds-data-low); }

  .location-panel {
    display: flex;
    flex-direction: column;
    padding: var(--ds-space-5) var(--ds-space-6);
    background: var(--ds-surface);
  }

  .location-title {
    padding: var(--ds-space-8) 0 var(--ds-space-6);
    border-bottom: 1px solid var(--ds-border-light);
  }

  .location-title h3 {
    margin: 0 0 var(--ds-space-3);
    font: 400 clamp(2.4rem, 4vw, 4rem)/.94 var(--ds-font-serif);
    letter-spacing: -.04em;
  }

  .score-row { display: flex; align-items: baseline; gap: 5px; }
  .score-row strong { font: 500 clamp(3.2rem, 5vw, 5rem)/.88 var(--ds-font-sans); letter-spacing: -.06em; }
  .score-row span { color: var(--ds-subtle); font: 500 12px/1 var(--ds-font-sans); }
  .location-title p { margin: 8px 0 0; color: var(--ds-forest-800); font: 600 12px/1.2 var(--ds-font-sans); }

  .signal-list { display: grid; gap: var(--ds-space-4); padding: var(--ds-space-6) 0; }
  .signal { display: grid; gap: 7px; }
  .signal > div { display: flex; justify-content: space-between; gap: 12px; color: var(--ds-muted); font: 500 12px/1.2 var(--ds-font-sans); }
  .signal b { color: var(--ds-ink); font-weight: 500; }
  .signal i { height: 5px; overflow: hidden; background: var(--ds-surface-soft); }
  .signal em { display: block; height: 100%; background: var(--ds-forest-800); transition: width var(--ds-motion-base) var(--ds-ease); }

  .panel-note {
    margin-top: auto;
    padding: var(--ds-space-5);
    background: var(--ds-surface-soft);
  }

  .panel-note span { color: var(--ds-ink); font: 600 12px/1.2 var(--ds-font-sans); }
  .panel-note p { margin: 8px 0 0; color: var(--ds-muted); font: 400 13px/1.5 var(--ds-font-sans); }
  .location-panel > small { margin-top: var(--ds-space-4); color: var(--ds-subtle); font: 400 10px/1.4 var(--ds-font-sans); }

  @media (max-width: 920px) {
    .co-map { grid-template-columns: 1fr; }
    .map-canvas { border-right: 0; border-bottom: 1px solid var(--ds-border-light); }
    .location-panel { min-height: 520px; }
  }

  @media (max-width: 620px) {
    .co-map { min-height: auto; }
    .map-canvas,
    .location-panel { padding: var(--ds-space-5); }
    .italy-map { height: auto; max-height: 520px; }
    .map-head span:last-child { display: none; }
    .map-legend { gap: var(--ds-space-4); }
    .location-panel { min-height: auto; }
    .panel-note { margin-top: var(--ds-space-5); }
  }

  @media (prefers-reduced-motion: reduce) {
    .city-halo,
    .signal em { transition: none; }
  }
</style>
