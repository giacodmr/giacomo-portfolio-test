<div class="workflow-preview" data-workflow role="group" aria-label="AI-enabled consulting workflow preview">
  <div class="workflow-step" tabindex="0" data-workflow-step>
    <span>01</span>
    <strong>Business question</strong>
    <small>Objectives · Context · Constraints</small>
  </div>
  <div class="workflow-arrow" aria-hidden="true">→</div>
  <div class="workflow-step" tabindex="0" data-workflow-step>
    <span>02</span>
    <strong>Data & documents</strong>
    <small>Internal data · Reports · Materials</small>
  </div>
  <div class="workflow-arrow" aria-hidden="true">→</div>
  <div class="workflow-step workflow-step-accent" tabindex="0" data-workflow-step>
    <span>03</span>
    <strong>AI-supported analysis</strong>
    <small>Structure · Analyse · Synthesise</small>
  </div>
  <div class="workflow-arrow" aria-hidden="true">→</div>
  <div class="workflow-step" tabindex="0" data-workflow-step>
    <span>04</span>
    <strong>Consultant review</strong>
    <small>Validate · Refine · Apply context</small>
  </div>
  <div class="workflow-arrow" aria-hidden="true">→</div>
  <div class="workflow-step" tabindex="0" data-workflow-step>
    <span>05</span>
    <strong>Output / decision</strong>
    <small>Insights · Recommendations · Action</small>
  </div>
</div>

<script>
  document.querySelectorAll('[data-workflow]').forEach((workflow) => {
    const steps = workflow.querySelectorAll('[data-workflow-step]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const activate = (activeStep) => {
      workflow.classList.add('has-active');
      steps.forEach((step) => step.classList.toggle('is-active', step === activeStep));
    };

    const clear = () => {
      workflow.classList.remove('has-active');
      steps.forEach((step) => step.classList.remove('is-active'));
    };

    steps.forEach((step) => {
      step.addEventListener('mouseenter', () => activate(step));
      step.addEventListener('mouseleave', clear);
      step.addEventListener('focus', () => activate(step));
      step.addEventListener('blur', clear);
    });

    if (reduceMotion) {
      workflow.classList.add('is-ready');
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          workflow.classList.add('is-ready');
          observer.disconnect();
        });
      }, { threshold: 0.28 });
      observer.observe(workflow);
    }
  });
</script>

<style>
  .workflow-preview {
    display: grid;
