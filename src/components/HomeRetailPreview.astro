  .viz-panel header span { color: var(--ds-subtle, #6e7781); font-family: var(--ds-font-sans, 'IBM Plex Sans', sans-serif); font-size: .58rem; font-weight: 600; letter-spacing: .12em; }
  .viz-panel header strong { color: var(--ds-muted, #57606a); font-family: var(--ds-font-sans, 'IBM Plex Sans', sans-serif); font-size: .76rem; font-weight: 600; line-height: 1.25; }
  .viz-panel > p { min-height: 42px; margin: 15px 0 0; color: var(--ds-subtle, #6e7781); font-family: var(--ds-font-sans, 'IBM Plex Sans', sans-serif); font-size: .62rem; line-height: 1.42; }
  .viz-panel > p b { color: var(--ds-ink, #1f2328); font-weight: 600; }

  .histogram { height: 156px; display: flex; align-items: end; gap: 5px; padding-top: 16px; }
  .histogram i {
    flex: 1;
    height: var(--h);
