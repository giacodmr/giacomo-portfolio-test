<script>
  document.querySelectorAll('[data-commercial-map]').forEach((root) => {
    const cities = Array.from(root.querySelectorAll('.city'));
    const name = root.querySelector('[data-market-name]');
    const score = root.querySelector('[data-market-score]');
    const priority = root.querySelector('[data-market-priority]');
    const index = root.querySelector('.panel-index');

    const activate = (city) => {
      cities.forEach((item) => item.classList.toggle('active', item === city));
      if (name) name.textContent = city.getAttribute('data-name') || '';
      if (score) score.textContent = city.getAttribute('data-score') || '';
      if (priority) priority.textContent = city.getAttribute('data-priority') || '';
      if (index) index.textContent = `${String(cities.indexOf(city) + 1).padStart(2, '0')} / ${String(cities.length).padStart(2, '0')}`;
    };

    cities.forEach((city) => {
      city.addEventListener('mouseenter', () => activate(city));
      city.addEventListener('focus', () => activate(city));
      city.addEventListener('click', () => activate(city));
      city.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(city);
        }
      });
    });
  });
</script>

