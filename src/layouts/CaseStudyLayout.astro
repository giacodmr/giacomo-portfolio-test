---
import '../styles/design-tokens.css';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  eyebrow: string;
  client: string;
  question: string;
  summary: string;
}

const { title, eyebrow, client, question, summary } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f8fa" />
    <title>{title} — Giacomo Di Muro</title>
  </head>

  <body>
    <Navigation />

    <main class="case-page">
      <section class="container case-hero">
        <a class="case-back" href="/#work">← Selected work</a>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="case-client">{client}</p>
      </section>

      <section class="container case-question">
        <p class="eyebrow">Business question</p>
        <h2>{question}</h2>
        <p>{summary}</p>
      </section>

      <section class="container case-visual">
        <slot name="visual" />
      </section>

      <section class="container case-content">
        <slot />
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .case-page { padding: 54px 0 78px; background: var(--ds-canvas); }
  .case-hero { padding-top: 26px; padding-bottom: 70px; border-bottom: 1px solid var(--ds-border-light); }
  .case-back { display: inline-block; margin-bottom: 38px; color: var(--ds-muted); font-size: .72rem; font-weight: 500; transition: color var(--ds-motion-fast) ease; }
  .case-back:hover, .case-back:focus-visible { color: var(--ds-blue-600); }
  .case-hero h1 { max-width: 980px; margin: 18px 0 0; font: 400 clamp(3.4rem, 7vw, 6.8rem)/.9 var(--ds-font-serif); letter-spacing: -.055em; color: var(--ds-ink); }
  .case-client { margin: 22px 0 0; color: var(--ds-muted); font-size: .9rem; }
  .case-question { display: grid; grid-template-columns: .7fr 2fr; gap: 42px; padding-top: 66px; padding-bottom: 66px; }
  .case-question h2 { margin: 0; font: 400 clamp(2rem, 4vw, 3.6rem)/1 var(--ds-font-serif); letter-spacing: -.04em; color: var(--ds-ink); }
  .case-question > p:last-child { grid-column: 2; max-width: 760px; margin: 0; color: var(--ds-muted); font-size: .92rem; line-height: 1.65; }
  .case-visual { padding-bottom: 68px; }
  .case-content { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  :global(.case-block) { min-height: 220px; padding: 28px; border: 1px solid var(--ds-border); border-radius: var(--ds-radius-md); background: var(--ds-surface); }
  :global(.case-block h3) { margin: 0 0 16px; color: var(--ds-ink); font: 500 1rem/1.25 var(--ds-font-sans); }
  :global(.case-block p), :global(.case-block li) { color: var(--ds-muted); font-size: .78rem; line-height: 1.6; }
  :global(.case-block ul) { margin: 0; padding-left: 18px; }
  @media (max-width: 800px) {
    .case-question { grid-template-columns: 1fr; }
    .case-question > p:last-child { grid-column: 1; }
    .case-content { grid-template-columns: 1fr; }
  }
</style>
