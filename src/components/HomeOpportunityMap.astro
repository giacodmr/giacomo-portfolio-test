  .map-callout { position: absolute; top: 6%; right: 3%; display: grid; gap: 6px; min-width: 150px; padding: 14px 15px; border: 1px solid var(--ds-border, #d0d7de); border-radius: var(--ds-radius-sm, 8px); background: color-mix(in srgb, var(--ds-surface, #fff) 96%, transparent); box-shadow: 0 12px 32px rgba(31,35,40,.08); }
  .callout-kicker { color: var(--ds-subtle, #6e7781); font: 600 .52rem/1.2 var(--ds-font-sans, 'IBM Plex Sans', sans-serif); letter-spacing: .14em; text-transform: uppercase; }
