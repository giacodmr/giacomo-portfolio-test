---
const clusters = [
  { name: 'High-value', index: 121, revenue: 126, ticket: 121, frequency: 118, profitability: 119, x: 478, y: 82, tier: 'focus' },
  { name: 'Growth', index: 108, revenue: 112, ticket: 108, frequency: 104, profitability: 106, x: 408, y: 128, tier: 'accent' },
  { name: 'Core', index: 94, revenue: 96, ticket: 94, frequency: 91, profitability: 93, x: 316, y: 186, tier: 'core' },
  { name: 'At-risk', index: 82, revenue: 79, ticket: 82, frequency: 75, profitability: 80, x: 210, y: 244, tier: 'context' },
];

const points = [
  [118,258],[136,245],[151,271],[167,232],[181,253],[198,219],[216,238],[232,210],[247,226],[263,199],
  [278,217],[294,190],[309,203],[326,176],[341,194],[356,162],[371,179],[388,145],[402,160],[417,131],
  [431,149],[447,117],[463,136],[481,104],[497,121],[512,92],[529,110],[545,79],[563,99],[579,71],
  [142,281],[173,264],[205,247],[238,236],[272,214],[305,195],[337,184],[369,157],[401,142],[435,123],
  [468,106],[501,90],[535,76],[568,64],[190,286],[223,269],[256,249],[289,231],[323,210],[356,193],
  [389,171],[422,151],[455,134],[488,113],[521,96],[554,82]
];
---

<div class="retail-visual" data-retail-visual>
  <div class="scatter-panel">
    <div class="visual-head">
      <span>Store performance landscape</span>
      <span>Illustrative reconstruction</span>
    </div>

    <svg class="store-scatter" viewBox="0 0 640 360" role="img" aria-labelledby="retail-scatter-title retail-scatter-desc">
      <title id="retail-scatter-title">Synthetic retail performance scatter plot</title>
      <desc id="retail-scatter-desc">Illustrative store-level relationship between revenue index and profitability index, with four representative performance clusters.</desc>

      <rect class="priority-zone" x="365" y="42" width="220" height="110" />
      <text class="zone-label" x="382" y="63">HIGH-VALUE PERFORMANCE</text>

      <line class="axis" x1="72" y1="302" x2="590" y2="302" />
      <line class="axis" x1="72" y1="302" x2="72" y2="38" />
      <line class="gridline" x1="72" y1="213" x2="590" y2="213" />
      <line class="gridline" x1="72" y1="125" x2="590" y2="125" />
      <line class="gridline" x1="245" y1="38" x2="245" y2="302" />
      <line class="gridline" x1="418" y1="38" x2="418" y2="302" />

      <g class="store-points" aria-hidden="true">
        {points.map(([x,y], index) => (
          <circle cx={x} cy={y} r={index % 9 === 0 ? 4.3 : 3.2} class={index > 38 ? 'upper' : 'context'} />
        ))}
      </g>

      <g class="cluster-points">
        {clusters.map((cluster, index) => (
          <g
            class={`cluster-point ${cluster.tier} ${index === 0 ? 'is-active' : ''}`}
            tabindex="0"
            role="button"
            aria-label={`${cluster.name} cluster, synthetic performance index ${cluster.index}`}
            data-name={cluster.name}
            data-index={cluster.index}
            data-revenue={cluster.revenue}
            data-ticket={cluster.ticket}
            data-frequency={cluster.frequency}
            data-profitability={cluster.profitability}
            transform={`translate(${cluster.x} ${cluster.y})`}
          >
            <circle class="cluster-halo" r="12" />
            <circle class="cluster-core" r="6" />
            <text x="13" y="-10">{cluster.name}</text>
          </g>
        ))}
      </g>

      <text class="axis-label" x="331" y="342" text-anchor="middle">Revenue index</text>
      <text class="axis-label" x="24" y="170" text-anchor="middle" transform="rotate(-90 24 170)">Profitability index</text>
      <text class="axis-end" x="72" y="320">Lower</text>
      <text class="axis-end" x="590" y="320" text-anchor="end">Higher</text>
    </svg>

    <div class="scatter-legend" aria-label="Scatter legend">
      <span><i class="legend-dot focus"></i>Selected cluster</span>
      <span><i class="legend-dot accent"></i>Higher performance</span>
      <span><i class="legend-dot context"></i>Network context</span>
    </div>
  </div>

  <aside class="cluster-panel" aria-live="polite">
    <div class="panel-topline">
      <span>Selected cluster</span>
      <span data-cluster-count>01 / 04</span>
    </div>

    <div class="cluster-title">
      <h3 data-cluster-name>High-value</h3>
      <div class="index-row"><strong data-cluster-index>121</strong><span>index</span></div>
      <p>Illustrative performance profile</p>
    </div>

    <div class="metric-list">
      <div class="metric-row">
        <div><span>Revenue index</span><b data-value-revenue>126</b></div>
        <i><em data-bar-revenue style="width:100%"></em></i>
      </div>
      <div class="metric-row">
        <div><span>Average ticket</span><b data-value-ticket>121</b></div>
        <i><em data-bar-ticket style="width:96%"></em></i>
      </div>
      <div class="metric-row">
        <div><span>Purchase frequency</span><b data-value-frequency>118</b></div>
        <i><em data-bar-frequency style="width:94%"></em></i>
      </div>
      <div class="metric-row">
        <div><span>Profitability index</span><b data-value-profitability>119</b></div>
        <i><em data-bar-profitability style="width:94%"></em></i>
      </div>
    </div>

    <div class="cluster-note">
      <span>How to read it</span>
      <p>Store economics and customer behaviour are read together to distinguish structural network patterns from local outliers.</p>
    </div>

    <small>Chart values are synthetic; project scale indicators are factual.</small>
  </aside>
</div>

<script>
  document.querySelectorAll('[data-retail-visual]').forEach((root) => {
    const clusters = [...root.querySelectorAll('.cluster-point')];
    const setText = (selector, value) => {
      const node = root.querySelector(selector);
      if (node) node.textContent = String(value);
    };
    const setBar = (selector, value) => {
      const node = root.querySelector(selector);
      if (node instanceof HTMLElement) node.style.width = `${Math.min(100, Math.max(0, Number(value) / 1.26))}%`;
    };

    const activate = (cluster, index) => {
      clusters.forEach((item) => item.classList.toggle('is-active', item === cluster));
      const data = cluster.dataset;
      setText('[data-cluster-count]', `${String(index + 1).padStart(2, '0')} / ${String(clusters.length).padStart(2, '0')}`);
      setText('[data-cluster-name]', data.name || '');
      setText('[data-cluster-index]', data.index || '');
      ['revenue','ticket','frequency','profitability'].forEach((key) => {
        const value = data[key] || '0';
        setText(`[data-value-${key}]`, value);
        setBar(`[data-bar-${key}]`, value);
      });
    };

    clusters.forEach((cluster, index) => {
      cluster.addEventListener('mouseenter', () => activate(cluster, index));
      cluster.addEventListener('focus', () => activate(cluster, index));
      cluster.addEventListener('click', () => activate(cluster, index));
      cluster.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(cluster, index);
        }
      });
    });
  });
</script>

<style>
  .retail-visual {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(280px, .68fr);
    min-height: 560px;
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-md);
    overflow: hidden;
    background: var(--ds-surface);
  }

  .scatter-panel {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: var(--ds-space-5) var(--ds-space-6);
    border-right: 1px solid var(--ds-border-light);
  }

  .visual-head,
  .panel-topline {
    display: flex;
    justify-content: space-between;
    gap: var(--ds-space-4);
    color: var(--ds-subtle);
    font: 600 10px/1.2 var(--ds-font-sans);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .store-scatter {
    width: 100%;
    height: 420px;
    margin-top: var(--ds-space-3);
    overflow: visible;
  }

  .priority-zone { fill: var(--ds-forest-100); opacity: .68; }
  .zone-label { fill: var(--ds-forest-800); font: 600 9px/1 var(--ds-font-sans); letter-spacing: .1em; }
  .axis { stroke: var(--ds-ink); stroke-width: 1; opacity: .48; }
  .gridline { stroke: var(--ds-border-light); stroke-width: 1; stroke-dasharray: 3 4; }
  .axis-label { fill: var(--ds-muted); font: 500 10px/1 var(--ds-font-sans); }
  .axis-end { fill: var(--ds-subtle); font: 400 9px/1 var(--ds-font-sans); }

  .store-points .context { fill: var(--ds-data-low); opacity: .72; }
  .store-points .upper { fill: var(--ds-forest-500); opacity: .58; }

  .cluster-point { cursor: pointer; outline: none; }
  .cluster-halo {
    fill: var(--ds-surface);
    stroke: transparent;
    stroke-width: 1.7;
    transition: r var(--ds-motion-fast) var(--ds-ease), stroke var(--ds-motion-fast) ease;
  }
  .cluster-core { fill: var(--ds-data-low); }
  .cluster-point.accent .cluster-core { fill: var(--ds-forest-500); }
  .cluster-point.focus .cluster-core { fill: var(--ds-forest-800); }
  .cluster-point.core .cluster-core { fill: color-mix(in srgb, var(--ds-forest-500) 72%, var(--ds-data-low)); }

  .cluster-point text {
    fill: var(--ds-ink);
    font: 500 11px/1 var(--ds-font-sans);
    paint-order: stroke;
    stroke: var(--ds-surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .cluster-point:hover .cluster-halo,
  .cluster-point:focus-visible .cluster-halo,
  .cluster-point.is-active .cluster-halo {
    r: 15px;
    stroke: var(--ds-forest-800);
  }

  .scatter-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-5);
    margin-top: auto;
    color: var(--ds-muted);
    font: 500 11px/1.2 var(--ds-font-sans);
  }
  .scatter-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .legend-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }
  .legend-dot.focus { background: var(--ds-forest-800); }
  .legend-dot.accent { background: var(--ds-forest-500); }
  .legend-dot.context { background: var(--ds-data-low); }

  .cluster-panel {
    display: flex;
    flex-direction: column;
    padding: var(--ds-space-5) var(--ds-space-6);
  }

  .cluster-title {
    padding: var(--ds-space-7) 0 var(--ds-space-5);
    border-bottom: 1px solid var(--ds-border-light);
  }
  .cluster-title h3 {
    margin: 0 0 var(--ds-space-3);
    font: 400 clamp(2.2rem, 3.5vw, 3.5rem)/.94 var(--ds-font-serif);
    letter-spacing: -.04em;
  }
  .index-row { display: flex; align-items: baseline; gap: 7px; }
  .index-row strong { font: 500 clamp(3.2rem, 4.7vw, 4.8rem)/.88 var(--ds-font-sans); letter-spacing: -.06em; }
  .index-row span { color: var(--ds-subtle); font: 500 11px/1 var(--ds-font-sans); }
  .cluster-title p { margin: 8px 0 0; color: var(--ds-forest-800); font: 600 11px/1.2 var(--ds-font-sans); }

  .metric-list { display: grid; gap: var(--ds-space-4); padding: var(--ds-space-5) 0; }
  .metric-row { display: grid; gap: 7px; }
  .metric-row > div { display: flex; justify-content: space-between; gap: 12px; color: var(--ds-muted); font: 500 12px/1.2 var(--ds-font-sans); }
  .metric-row b { color: var(--ds-ink); font-weight: 500; }
  .metric-row i { height: 5px; overflow: hidden; background: var(--ds-surface-soft); }
  .metric-row em { display: block; height: 100%; background: var(--ds-forest-800); transition: width var(--ds-motion-base) var(--ds-ease); }

  .cluster-note { margin-top: auto; padding: var(--ds-space-5); background: var(--ds-surface-soft); }
  .cluster-note span { color: var(--ds-ink); font: 600 12px/1.2 var(--ds-font-sans); }
  .cluster-note p { margin: 8px 0 0; color: var(--ds-muted); font: 400 13px/1.5 var(--ds-font-sans); }
  .cluster-panel > small { margin-top: var(--ds-space-4); color: var(--ds-subtle); font: 400 10px/1.4 var(--ds-font-sans); }

  @media (max-width: 920px) {
    .retail-visual { grid-template-columns: 1fr; }
    .scatter-panel { border-right: 0; border-bottom: 1px solid var(--ds-border-light); }
    .cluster-panel { min-height: 500px; }
  }

  @media (max-width: 620px) {
    .scatter-panel,
    .cluster-panel { padding: var(--ds-space-5); }
    .store-scatter { height: auto; min-height: 320px; }
    .visual-head span:last-child { display: none; }
    .scatter-legend { gap: var(--ds-space-4); }
    .cluster-panel { min-height: auto; }
    .cluster-note { margin-top: var(--ds-space-5); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cluster-halo,
    .metric-row em { transition: none; }
  }
</style>
