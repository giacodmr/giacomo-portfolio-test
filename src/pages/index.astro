---
import '../styles/design-tokens.css';
import '../styles/global.css';
import '../styles/home.css';
import Navigation from '../components/Navigation.astro';
import FeaturedCase from '../components/FeaturedCase.astro';
import HomeRetailPreview from '../components/HomeRetailPreview.astro';
import AIWorkflow from '../components/AIWorkflow.astro';
import ExperienceStrip from '../components/ExperienceStrip.astro';
import Footer from '../components/Footer.astro';
import PrimerHero from '../components/primer/PrimerHero.jsx';
import PrimerProjectMeta from '../components/primer/PrimerProjectMeta.jsx';

const title = 'Giacomo Di Muro — Business Strategy & Analytics';
const description = 'Business strategy, analytics and applied AI for structured business decisions.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>

  <body class="home-page">
    <Navigation />

    <main>
      <section class="hero-section" aria-label="Introduction and featured work">
        <div class="container hero-shell">
          <div class="hero-copy">
            <PrimerHero />
            <div class="hero-proof">
              <span>Current role</span>
              <strong>Business Consultant · Client Strategy</strong>
              <p>Strategy, analytics and transformation work across consumer and commercial topics.</p>
            </div>
          </div>

          <FeaturedCase />
        </div>
      </section>

      <section class="work-section" aria-labelledby="more-work-title">
        <div class="container">
          <header class="section-intro">
            <p class="eyebrow">More selected work</p>
            <h2 id="more-work-title">Different problems. The same evidence-led approach.</h2>
            <p>Each project is anonymised or reconstructed to preserve confidentiality while showing the analytical logic and decision context.</p>
          </header>

          <article class="case-river case-river-reverse">
            <div class="case-copy">
              <p class="case-number">02 / 03 · Commercial analytics</p>
              <h3>Retail Performance Intelligence</h3>
              <p class="case-client">Leading consumer brand</p>
              <p class="case-question">How can retail performance patterns inform better network and commercial decisions?</p>
              <p class="case-body">Store- and customer-level performance patterns translated into network, profitability and commercial insights.</p>
              <PrimerProjectMeta
                tags={['Retail Strategy', 'Customer Analytics', 'Network Strategy']}
                stats={[{ value: '700k+', label: 'records analysed' }, { value: '150+', label: 'stores' }]}
                href="/work/retail-performance"
              />
            </div>
            <div class="case-visual retail-visual">
              <HomeRetailPreview />
            </div>
          </article>

          <article class="case-river ai-river">
            <div class="case-copy">
              <p class="case-number">03 / 03 · Applied AI</p>
              <h3>AI-enabled Consulting Workflows</h3>
              <p class="case-client">Internal transformation / Consulting organisation</p>
              <p class="case-question">How can recurring consulting workflows use AI while preserving human judgement?</p>
              <p class="case-body">A controlled workflow connecting business inputs, AI-supported analysis, consultant review and decision-ready outputs.</p>
              <PrimerProjectMeta
                tags={['Applied AI', 'Process Redesign', 'Transformation']}
                stats={[]}
                href="/work/ai-workflows"
                colorMode="dark"
              />
              <p class="ai-annotation">Selected as AI Champion — Consumer</p>
            </div>
            <div class="case-visual ai-visual">
              <AIWorkflow />
            </div>
          </article>
        </div>
      </section>

      <ExperienceStrip />
    </main>

    <Footer />
  </body>
</html>
