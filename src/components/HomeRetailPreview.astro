  }

  @media (prefers-reduced-motion: reduce) {
    .viz-panel, .histogram i, .hbar-row > i > b, .trend-line, .dot { transition: none; }
    .histogram i, .hbar-row > i > b { transform: none; }
    .trend-line { stroke-dashoffset: 0; }
  }
</style>
