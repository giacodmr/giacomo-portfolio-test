---
import '../../styles/global.css';
import '../../styles/design-tokens.css';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import CommercialOpportunityMap from '../../components/CommercialOpportunityMap.astro';

const approach = [
  { number: '01', title: 'Frame the network', copy: 'Define the scope and create a consistent view of the commercial universe.' },
  { number: '02', title: 'Read market signals', copy: 'Bring together market, commercial and competitive information across locations.' },
  { number: '03', title: 'Assess potential', copy: 'Translate multiple signals into a structured view of relative opportunity.' },
  { number: '04', title: 'Compare opportunities', copy: 'Prioritise locations through a consistent commercial comparison logic.' },
  { number: '05', title: 'Translate into action', copy: 'Turn the analysis into decision-support outputs and go-to-market priorities.' },
];

const contribution = [
  'Supported the analytical and commercial prioritisation approach across a large location network.',
  'Performed market and competitor analysis to interpret local opportunity signals.',
  'Supported revenue / sales-potential estimation and profitability thinking within the assessment.',
  'Translated findings into management-ready decision-support outputs and go-to-market priorities.',
];

const decisions = [
  'Compare opportunities on a consistent basis',
  'Surface commercially attractive areas',
  'Support targeting and commercial focus',
  'Create a structured basis for go-to-market decisions',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1e9" />
    <meta name="description" content="Commercial opportunity prioritisation case study by Giacomo Di Muro." />
    <title>Commercial Opportunity Prioritisation — Giacomo Di Muro</title>
  </head>

  <body>
    <Navigation />

    <main class="co-page">
      <section class="container hero">
        <div class="hero-main">
          <p class="eyebrow ds-eyebrow">01 / 03 · Commercial Strategy</p>
          <h1>Commercial Opportunity Prioritisation</h1>
          <p class="client">Global beverage company</p>
          <p class="hero-summary">
            A data-driven approach to structure and prioritise commercial opportunities across Italy,
            combining market, commercial, competitive and contextual signals into a clearer basis for action.
          </p>
        </div>

        <aside class="hero-meta" aria-label="Project overview">
          <div class="hero-kpi">
            <strong>12k+</strong>
            <span>locations analysed</span>
          </div>

          <div class="meta-row">
            <span class="meta-label">Market</span>
            <b>Italy · 9 markets</b>
          </div>

          <div class="meta-row capability-row">
            <span class="meta-label">Capabilities</span>
            <div class="capabilities">
              <span>Commercial strategy</span>
              <span>Market analytics</span>
              <span>GTM</span>
              <span>Prioritisation</span>
            </div>
          </div>

          <p class="meta-note">Client identity, scoring values and visual details are adapted for confidentiality.</p>
        </aside>
      </section>

      <section class="container statement-section">
        <div class="section-label"><span>01</span> Business question</div>
        <div class="statement-grid">
          <h2>Which commercial opportunities should be prioritised?</h2>
          <p>
            A large commercial network creates a focus problem: thousands of locations may be relevant,
            but they do not carry the same market potential, commercial attractiveness or strategic relevance.
          </p>
        </div>
      </section>

      <section class="container statement-section context-section">
        <div class="section-label"><span>02</span> Context</div>
        <div class="statement-grid">
          <h2>Not every location represents the same strategic or commercial opportunity.</h2>
          <p>
            The work brought together market, territorial, competitive and commercial information to create
            a more structured way to compare locations and decide where commercial attention should go first.
          </p>
        </div>
      </section>

      <section class="container approach-section">
        <div class="approach-intro">
          <div class="section-label"><span>03</span> Approach</div>
          <p>A five-step logic moved the work from a fragmented location universe to comparable commercial priorities.</p>
        </div>

        <div class="approach-grid">
          {approach.map((step) => (
            <article class="approach-step">
              <span class="step-number">{step.number}</span>
              <div class="step-mark" aria-hidden="true"><i></i><i></i><i></i></div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="container analytical-section">
        <div class="analytical-head">
          <div>
            <div class="section-label"><span>04</span> Analytical work</div>
            <h2>From locations to a comparable opportunity view.</h2>
          </div>
          <p>
            The analytical logic combines different commercial signals into one consistent comparison layer,
            making it easier to identify where deeper attention and field action may be most valuable.
          </p>
        </div>

        <CommercialOpportunityMap />

        <div class="artifact-grid">
          <article class="matrix-card">
            <div class="artifact-head">
              <div>
                <span>Opportunity matrix</span>
                <h3>Compare markets on two commercial dimensions.</h3>
              </div>
              <small>Synthetic values</small>
            </div>

            <svg class="matrix" viewBox="0 0 620 330" role="img" aria-label="Illustrative opportunity matrix comparing market attractiveness and ease of execution">
              <rect class="priority-zone" x="344" y="36" width="228" height="112" />
              <text class="zone-label" x="360" y="57">PRIORITY OPPORTUNITIES</text>

              <line class="axis" x1="72" y1="278" x2="572" y2="278" />
              <line class="axis" x1="72" y1="278" x2="72" y2="36" />
              <line class="gridline" x1="72" y1="158" x2="572" y2="158" />
              <line class="gridline" x1="322" y1="36" x2="322" y2="278" />

              <g class="matrix-context" aria-hidden="true">
                <circle cx="118" cy="244" r="5"/><circle cx="147" cy="220" r="5"/><circle cx="186" cy="235" r="5"/>
                <circle cx="213" cy="194" r="5"/><circle cx="251" cy="208" r="5"/><circle cx="279" cy="174" r="5"/>
                <circle cx="305" cy="218" r="5"/><circle cx="347" cy="181" r="5"/><circle cx="382" cy="194" r="5"/>
                <circle cx="419" cy="164" r="5"/><circle cx="456" cy="173" r="5"/>
              </g>

              <g class="matrix-focus">
                <circle cx="515" cy="76" r="7"/><text x="528" y="80">Milan</text>
                <circle cx="463" cy="112" r="7"/><text x="476" y="116">Rome</text>
                <circle class="secondary" cx="432" cy="139" r="6"/><text x="445" y="143">Bari</text>
                <circle class="secondary" cx="390" cy="128" r="6"/><text x="403" y="132">Bologna</text>
                <circle class="context" cx="306" cy="171" r="6"/><text x="319" y="175">Florence</text>
              </g>

              <text class="axis-label" x="322" y="318" text-anchor="middle">Ease of execution</text>
              <text class="axis-label" x="24" y="158" text-anchor="middle" transform="rotate(-90 24 158)">Market attractiveness</text>
              <text class="axis-end" x="72" y="298">Low</text>
              <text class="axis-end" x="572" y="298" text-anchor="end">High</text>
              <text class="axis-end" x="54" y="278" text-anchor="end">Low</text>
              <text class="axis-end" x="54" y="42" text-anchor="end">High</text>
            </svg>
          </article>

          <article class="logic-card">
            <div class="artifact-head dark">
              <div>
                <span>Prioritisation logic</span>
                <h3>Multiple signals, one decision-support view.</h3>
              </div>
              <small>Framework</small>
            </div>

            <div class="logic-flow">
              <div class="logic-signals">
                <div><i>01</i><p><strong>Commercial</strong><span>Sales potential · profitability thinking</span></p></div>
                <div><i>02</i><p><strong>Market</strong><span>Local attractiveness · demand signals</span></p></div>
                <div><i>03</i><p><strong>Context</strong><span>Competition · territory · execution factors</span></p></div>
              </div>
              <div class="logic-connector" aria-hidden="true"><span></span><b>→</b></div>
              <div class="logic-output">
                <span>Comparable</span>
                <strong>commercial priorities</strong>
                <p>A clear, repeatable basis for focused action.</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="container contribution-section">
        <div class="contribution-copy">
          <div class="section-label"><span>05</span> My contribution</div>
          <h2>Turning analysis into commercial decision support.</h2>
          <p>My role focused on analytical structure, commercial interpretation and management-ready outputs within the broader project team.</p>
        </div>

        <ol class="contribution-list">
          {contribution.map((item, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
          ))}
        </ol>
      </section>

      <section class="decision-band">
        <div class="container decision-inner">
          <div class="decision-copy">
            <div class="section-label light"><span>06</span> Decision enabled</div>
            <h2>A clearer basis for deciding where commercial attention should go first.</h2>
            <p>The analysis created a structured way to move from thousands of locations to a more focused set of commercial priorities.</p>
          </div>

          <ul class="decision-list">
            {decisions.map((item) => (
              <li><span aria-hidden="true">✓</span>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="container evidence-section">
        <div class="evidence-head">
          <div class="section-label"><span>07</span> Evidence</div>
          <p>Selected factual indicators that can be shared publicly.</p>
        </div>

        <div class="evidence-grid">
          <div class="evidence-item key"><strong>12k+</strong><span>locations analysed</span></div>
          <div class="evidence-item"><strong>9</strong><span>Italian markets</span></div>
          <div class="evidence-item"><strong>4</strong><span>capability areas</span><small>Commercial Strategy · Market Analytics · GTM · Prioritisation</small></div>
          <div class="evidence-item text"><strong>Decision support</strong><span>Structured basis for commercial prioritisation</span></div>
        </div>

        <p class="confidentiality">Illustrative reconstruction with synthetic visual values. Client identity and sensitive commercial details are withheld for confidentiality.</p>
      </section>

      <section class="container next-project">
        <span>Next project</span>
        <a href="/work/retail-performance">
          <strong>Retail Performance Intelligence</strong>
          <i aria-hidden="true">→</i>
        </a>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .co-page {
    padding-bottom: var(--ds-space-8);
    background: var(--ds-canvas);
  }

  .ds-eyebrow { color: var(--ds-forest-800); }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(360px, .7fr);
    gap: var(--ds-space-9);
    align-items: start;
    padding-top: var(--ds-space-8);
    padding-bottom: var(--ds-space-8);
    border-bottom: 1px solid var(--ds-border-light);
  }

  .hero-main { max-width: 850px; }

  .hero h1 {
    max-width: 800px;
    margin: var(--ds-space-4) 0 0;
    font: 400 clamp(3.6rem, 6vw, 5.6rem)/.92 var(--ds-font-serif);
    letter-spacing: -.045em;
  }

  .client {
    margin: var(--ds-space-4) 0 0;
    color: var(--ds-ink);
    font: 400 17px/1.35 var(--ds-font-serif);
  }

  .hero-summary {
    max-width: 720px;
    margin: var(--ds-space-5) 0 0;
    color: var(--ds-muted);
    font: 400 17px/1.58 var(--ds-font-sans);
  }

  .hero-meta {
    padding: var(--ds-space-6);
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-sm);
    background: var(--ds-surface);
  }

  .hero-kpi {
    display: grid;
    gap: var(--ds-space-2);
    padding-bottom: var(--ds-space-6);
    border-bottom: 1px solid var(--ds-border-light);
  }

  .hero-kpi strong {
    color: var(--ds-forest-800);
    font: 500 clamp(3.6rem, 5.4vw, 5rem)/.82 var(--ds-font-sans);
    letter-spacing: -.065em;
  }

  .hero-kpi span {
    color: var(--ds-subtle);
    font: 600 10px/1.2 var(--ds-font-sans);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .meta-row {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: var(--ds-space-4);
    padding: var(--ds-space-5) 0;
    border-bottom: 1px solid var(--ds-border-light);
  }

  .meta-label {
    color: var(--ds-subtle);
    font: 600 10px/1.35 var(--ds-font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .meta-row b {
    color: var(--ds-ink);
    font: 500 13px/1.4 var(--ds-font-sans);
  }

  .capabilities { display: flex; flex-wrap: wrap; gap: 7px; }
  .capabilities span {
    padding: 7px 11px;
    border-radius: var(--ds-radius-pill);
    background: var(--ds-tag-bg);
    color: var(--ds-tag-text);
    font: 500 11px/1 var(--ds-font-sans);
  }

  .meta-note {
    margin: var(--ds-space-5) 0 0;
    color: var(--ds-subtle);
    font: 400 11px/1.5 var(--ds-font-sans);
  }

  .statement-section {
    padding-top: var(--ds-space-8);
    padding-bottom: var(--ds-space-8);
    border-bottom: 1px solid var(--ds-border-light);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ds-forest-800);
    font: 600 10px/1 var(--ds-font-sans);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .section-label span { color: var(--ds-subtle); }

  .statement-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr);
    gap: var(--ds-space-9);
    align-items: start;
    margin-top: var(--ds-space-5);
  }

  .statement-grid h2,
  .analytical-head h2,
  .contribution-copy h2,
  .decision-copy h2 {
    margin: 0;
    font: 400 clamp(2.6rem, 4vw, 4rem)/.98 var(--ds-font-serif);
    letter-spacing: -.035em;
  }

  .statement-grid h2 { max-width: 780px; }

  .statement-grid p,
  .analytical-head > p,
  .contribution-copy > p,
  .decision-copy > p {
    margin: var(--ds-space-2) 0 0;
    color: var(--ds-muted);
    font: 400 15px/1.6 var(--ds-font-sans);
  }

  .statement-grid > p {
    padding-left: var(--ds-space-7);
    border-left: 1px solid var(--ds-border-light);
  }

  .approach-section {
    padding-top: var(--ds-space-8);
    padding-bottom: var(--ds-space-9);
  }

  .approach-intro {
    display: grid;
    grid-template-columns: minmax(180px, .34fr) minmax(0, 1fr);
    gap: var(--ds-space-7);
    align-items: start;
    margin-bottom: var(--ds-space-6);
  }

  .approach-intro p {
    max-width: 640px;
    margin: 0;
    color: var(--ds-muted);
    font: 400 14px/1.55 var(--ds-font-sans);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--ds-border);
    border-bottom: 1px solid var(--ds-border);
  }

  .approach-step {
    min-height: 230px;
    padding: var(--ds-space-5);
  }

  .approach-step + .approach-step { border-left: 1px solid var(--ds-border-light); }
  .step-number { color: var(--ds-forest-800); font: 600 11px/1 var(--ds-font-sans); }

  .step-mark {
    display: flex;
    align-items: end;
    gap: 3px;
    height: 26px;
    margin: var(--ds-space-5) 0;
  }

  .step-mark i { width: 5px; background: var(--ds-forest-800); }
  .step-mark i:nth-child(1) { height: 9px; }
  .step-mark i:nth-child(2) { height: 17px; }
  .step-mark i:nth-child(3) { height: 25px; }

  .approach-step:nth-child(1) .step-mark i:nth-child(1),
  .approach-step:nth-child(1) .step-mark i:nth-child(3) { height: 17px; }
  .approach-step:nth-child(1) .step-mark i:nth-child(2) { height: 17px; border-radius: 50%; }
  .approach-step:nth-child(3) .step-mark { align-items: center; }
  .approach-step:nth-child(3) .step-mark i { width: 24px; height: 5px; border-radius: var(--ds-radius-pill); }
  .approach-step:nth-child(4) .step-mark i:nth-child(1) { height: 25px; }
  .approach-step:nth-child(4) .step-mark i:nth-child(2) { height: 14px; }
  .approach-step:nth-child(4) .step-mark i:nth-child(3) { height: 21px; }
  .approach-step:nth-child(5) .step-mark { align-items: center; }
  .approach-step:nth-child(5) .step-mark i { width: 24px; height: 2px; }

  .approach-step h3 {
    margin: 0;
    font: 400 21px/1.1 var(--ds-font-serif);
    letter-spacing: -.025em;
  }

  .approach-step p {
    margin: var(--ds-space-3) 0 0;
    color: var(--ds-muted);
    font: 400 12px/1.55 var(--ds-font-sans);
  }

  .analytical-section { padding-bottom: var(--ds-space-9); }

  .analytical-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr);
    gap: var(--ds-space-9);
    align-items: end;
    margin-bottom: var(--ds-space-6);
  }

  .analytical-head h2 {
    max-width: 700px;
    margin-top: var(--ds-space-4);
  }

  .artifact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ds-space-4);
    margin-top: var(--ds-space-4);
  }

  .matrix-card,
  .logic-card {
    min-width: 0;
    padding: var(--ds-space-6);
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-sm);
    overflow: hidden;
  }

  .matrix-card { background: var(--ds-surface); }
  .logic-card { background: var(--ds-forest-900); color: var(--ds-light); }

  .artifact-head {
    display: flex;
    justify-content: space-between;
    gap: var(--ds-space-5);
    align-items: start;
  }

  .artifact-head span {
    color: var(--ds-subtle);
    font: 600 10px/1 var(--ds-font-sans);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .artifact-head h3 {
    max-width: 460px;
    margin: var(--ds-space-3) 0 0;
    font: 400 clamp(1.8rem, 2.6vw, 2.7rem)/1 var(--ds-font-serif);
    letter-spacing: -.035em;
  }

  .artifact-head small { color: var(--ds-subtle); font: 400 10px/1.3 var(--ds-font-sans); }
  .artifact-head.dark span,
  .artifact-head.dark small { color: var(--ds-forest-500); }

  .matrix { width: 100%; height: auto; margin-top: var(--ds-space-6); }
  .priority-zone { fill: var(--ds-forest-100); opacity: .72; }
  .axis { stroke: var(--ds-ink); stroke-width: 1; opacity: .5; }
  .gridline { stroke: var(--ds-border); stroke-width: 1; stroke-dasharray: 3 4; }
  .zone-label { fill: var(--ds-forest-800); font: 600 9px/1 var(--ds-font-sans); letter-spacing: .1em; }
  .matrix-context circle { fill: var(--ds-data-low); }
  .matrix-focus circle { fill: var(--ds-forest-800); }
  .matrix-focus circle.secondary { fill: var(--ds-forest-500); }
  .matrix-focus circle.context { fill: var(--ds-data-low); }
  .matrix-focus text { fill: var(--ds-ink); font: 500 11px/1 var(--ds-font-sans); }
  .axis-label { fill: var(--ds-muted); font: 500 10px/1 var(--ds-font-sans); }
  .axis-end { fill: var(--ds-subtle); font: 400 9px/1 var(--ds-font-sans); }

  .logic-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px minmax(190px, .72fr);
    gap: var(--ds-space-5);
    align-items: center;
    margin-top: var(--ds-space-7);
  }

  .logic-signals { display: grid; gap: 0; }
  .logic-signals > div {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: var(--ds-space-4);
    align-items: center;
    padding: var(--ds-space-4) 0;
    border-bottom: 1px solid rgba(244,247,243,.13);
  }

  .logic-signals i { color: var(--ds-forest-500); font: 600 10px/1 var(--ds-font-sans); font-style: normal; }
  .logic-signals p { display: grid; gap: 4px; margin: 0; }
  .logic-signals strong { color: var(--ds-light); font: 500 13px/1.2 var(--ds-font-sans); }
  .logic-signals span { color: rgba(244,247,243,.58); font: 400 11px/1.35 var(--ds-font-sans); }

  .logic-connector { display: flex; align-items: center; }
  .logic-connector span { width: 100%; height: 1px; background: var(--ds-forest-500); opacity: .55; }
  .logic-connector b { color: var(--ds-forest-500); font: 400 19px/1 var(--ds-font-sans); }

  .logic-output {
    padding: var(--ds-space-5);
    border: 1px solid rgba(244,247,243,.28);
    border-radius: var(--ds-radius-xs);
  }

  .logic-output > span { color: var(--ds-forest-500); font: 600 9px/1 var(--ds-font-sans); letter-spacing: .12em; text-transform: uppercase; }
  .logic-output strong { display: block; margin-top: var(--ds-space-3); color: var(--ds-light); font: 400 27px/1 var(--ds-font-serif); letter-spacing: -.03em; }
  .logic-output p { margin: var(--ds-space-4) 0 0; color: rgba(244,247,243,.6); font: 400 11px/1.5 var(--ds-font-sans); }

  .contribution-section {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: var(--ds-space-9);
    align-items: start;
    padding-top: var(--ds-space-8);
    padding-bottom: var(--ds-space-9);
    border-top: 1px solid var(--ds-border-light);
  }

  .contribution-copy h2 { max-width: 600px; margin-top: var(--ds-space-4); }
  .contribution-copy > p { max-width: 600px; margin-top: var(--ds-space-5); }

  .contribution-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ds-border);
  }

  .contribution-list li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--ds-space-4);
    padding: var(--ds-space-5) 0;
    border-bottom: 1px solid var(--ds-border-light);
  }

  .contribution-list li > span { color: var(--ds-forest-800); font: 600 10px/1.6 var(--ds-font-sans); }
  .contribution-list p { margin: 0; color: var(--ds-muted); font: 400 14px/1.55 var(--ds-font-sans); }

  .decision-band {
    background: var(--ds-forest-900);
    color: var(--ds-light);
  }

  .decision-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .72fr);
