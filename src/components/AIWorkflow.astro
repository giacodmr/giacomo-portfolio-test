    min-height:720px;
    overflow:hidden;
    border:1px solid rgba(239,242,236,.1);
    border-radius:28px;
    background:
      radial-gradient(circle at 47% 43%, rgba(115,171,137,.16), transparent 24%),
      radial-gradient(circle at 80% 75%, rgba(255,255,255,.05), transparent 28%),
      #101b16;
  }
  .stage-label { position:absolute; top:28px; left:30px; color:rgba(239,242,236,.45); font-size:10px; letter-spacing:.12em; text-transform:uppercase; }
  .node { position:absolute; display:grid; gap:8px; padding:20px 22px; border:1px solid rgba(239,242,236,.13); border-radius:16px; background:rgba(239,242,236,.035); backdrop-filter:blur(8px); opacity:0; transform:translateY(16px); transition:opacity .6s ease, transform .7s cubic-bezier(.22,1,.36,1), border-color .25s ease; }
  .node:hover { border-color:rgba(151,206,170,.48); }
  .node span { color:rgba(239,242,236,.38); font-size:10px; letter-spacing:.12em; }
  .node strong { color:#f1f3ef; font-size:17px; font-weight:500; }
