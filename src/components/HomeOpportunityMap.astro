<script>
  document.querySelectorAll('[data-home-opportunity-map]').forEach((map) => {
    const markers = map.querySelectorAll('.city-marker');
    const city = map.querySelector('[data-map-city]');
    const score = map.querySelector('[data-map-score]');
    const priority = map.querySelector('[data-map-priority]');

    const activate = (marker) => {
      markers.forEach((item) => item.classList.remove('is-active'));
      marker.classList.add('is-active');
      if (city) city.textContent = marker.dataset.city || '';
      if (score) score.textContent = marker.dataset.score || '';
      if (priority) priority.textContent = marker.dataset.priority || '';
    };

    markers.forEach((marker) => {
      marker.addEventListener('mouseenter', () => activate(marker));
      marker.addEventListener('focus', () => activate(marker));
      marker.addEventListener('click', () => activate(marker));
      marker.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(marker);
        }
      });
    });
  });
</script>

<style>
  .home-opportunity-map { width: 100%; min-width: 0; }
