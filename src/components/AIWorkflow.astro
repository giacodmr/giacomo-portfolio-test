  .node-question { left:7%; top:17%; width:210px; }
  .branch { position:absolute; left:8%; top:49%; display:grid; gap:10px; opacity:0; transform:translateY(16px); transition:opacity .6s .15s ease, transform .7s .15s cubic-bezier(.22,1,.36,1); }
  .mini-node { min-width:130px; padding:10px 13px; border-left:1px solid rgba(151,206,170,.45); color:rgba(239,242,236,.65); font-size:12px; }
  .node-ai { left:38%; top:34%; width:230px; border-color:rgba(151,206,170,.38); background:rgba(87,145,109,.1); }
  .node-ai i { position:absolute; inset:-10px; border:1px solid rgba(151,206,170,.12); border-radius:22px; animation:pulse 3s ease-in-out infinite; }
  .node-review { right:8%; top:27%; width:230px; }
  .node-output { right:8%; bottom:14%; width:230px; background:#edf1eb; }
  .node-output span, .node-output small { color:#657066; }
  .node-output strong { color:#101b16; }
  .flow-line { position:absolute; height:1px; background:linear-gradient(90deg, rgba(151,206,170,.08), rgba(151,206,170,.55), rgba(151,206,170,.08)); transform-origin:left; transform:scaleX(0); transition:transform 1s cubic-bezier(.22,1,.36,1); }
  .line-a { left:27%; top:30%; width:15%; transform:rotate(18deg) scaleX(0); }
  .line-b { left:24%; top:55%; width:19%; transform:rotate(-14deg) scaleX(0); }
  .line-c { left:61%; top:43%; width:18%; transform:rotate(-8deg) scaleX(0); }
  .line-d { right:18%; top:50%; width:18%; transform:rotate(90deg) scaleX(0); }
  .human-note { position:absolute; left:38%; bottom:8%; max-width:260px; margin:0; color:rgba(239,242,236,.42); font-family:'Instrument Serif',Georgia,serif; font-size:20px; line-height:1.12; }
  .is-visible .node, .is-visible .branch { opacity:1; transform:translateY(0); }
  .is-visible .node-ai { transition-delay:.25s; }
  .is-visible .node-review { transition-delay:.48s; }
  .is-visible .node-output { transition-delay:.72s; }
  .is-visible .line-a { transform:rotate(18deg) scaleX(1); transition-delay:.22s; }
  .is-visible .line-b { transform:rotate(-14deg) scaleX(1); transition-delay:.32s; }
  .is-visible .line-c { transform:rotate(-8deg) scaleX(1); transition-delay:.52s; }
  .is-visible .line-d { transform:rotate(90deg) scaleX(1); transition-delay:.75s; }
  @keyframes pulse { 0%,100%{opacity:.35; transform:scale(.985)} 50%{opacity:.8; transform:scale(1.015)} }
  @media (max-width:780px) {
    .ai-stage { min-height:760px; }
    .node-question { left:7%; top:12%; width:86%; }
    .branch { left:7%; top:28%; grid-template-columns:repeat(3,1fr); width:86%; }
    .mini-node { min-width:0; }
    .node-ai { left:7%; top:43%; width:86%; }
    .node-review { left:7%; right:auto; top:61%; width:86%; }
